<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Client Management</title>
  <link rel="stylesheet" href="/styles.css" />
  <style>
    .vendor-view-btn {
      padding: 5px 12px;
      border-radius: 6px;
      border: 1px solid #3b82f6;
      background: rgba(59, 130, 246, 0.1);
      color: #2563eb;
      font-weight: 600;
      font-size: 0.8rem;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .vendor-view-btn:hover {
      background: #2563eb;
      color: #ffffff;
    }
    .vendor-modal-close-btn {
      background: transparent !important;
      border: none !important;
      color: #ffffff !important;
      font-size: 28px !important;
      cursor: pointer !important;
      width: 36px !important;
      height: 36px !important;
      min-width: 36px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      border-radius: 50% !important;
      transition: background 0.2s ease !important;
      flex-shrink: 0 !important;
      line-height: 1 !important;
      padding: 0 !important;
      margin: 0 !important;
      box-shadow: none !important;
    }
    .vendor-modal-close-btn:hover {
      background: rgba(255, 255, 255, 0.2) !important;
      color: #ffffff !important;
    }

    /* Client Profile Centered Modal Overlay */
    .client-view-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(15, 23, 42, 0.65);
      backdrop-filter: blur(6px);
      z-index: 1200;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      opacity: 0;
      transition: opacity 0.25s ease;
    }
    .client-view-overlay.active {
      display: flex;
      opacity: 1;
    }
    .client-view-card {
      background: #ffffff;
      width: 100%;
      max-width: 1040px;
      max-height: 90vh;
      border-radius: 18px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      border: 1px solid #e2e8f0;
    }
    .system-theme.theme-dark .client-view-card,
    body.dark .client-view-card {
      background: #0f172a;
      border-color: #1e293b;
      color: #f8fafc;
    }
    .client-view-header {
      padding: 20px 24px;
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .client-profile-summary {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .client-avatar-wrapper {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      font-weight: 700;
      overflow: hidden;
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
      border: 2px solid #ffffff;
      flex-shrink: 0;
    }
    .client-avatar-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .client-header-details h2 {
      font-size: 20px;
      font-weight: 700;
      margin: 0 0 4px 0;
      color: #ffffff;
    }
    .client-header-meta {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .client-location-badge {
      background: rgba(16, 185, 129, 0.25);
      color: #a7f3d0;
      padding: 3px 10px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 600;
    }

    /* Top Clickable Summary Cards */
    .client-top-summary-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      padding: 16px 24px;
      background: #f8fafc;
      border-bottom: 1px solid #e2e8f0;
    }
    .system-theme.theme-dark .client-top-summary-grid,
    body.dark .client-top-summary-grid {
      background: #1e293b;
      border-color: #334155;
    }
    @media (max-width: 768px) {
      .client-top-summary-grid { grid-template-columns: repeat(2, 1fr); }
    }
    .client-summary-card {
      padding: 14px 16px;
      border-radius: 12px;
      background: #ffffff;
      border: 1.5px solid #e2e8f0;
      display: flex;
      align-items: center;
      gap: 12px;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .system-theme.theme-dark .client-summary-card,
    body.dark .client-summary-card {
      background: #0f172a;
      border-color: #334155;
    }
    .client-summary-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 16px -4px rgba(0, 0, 0, 0.1);
      border-color: #3b82f6;
    }
    .client-summary-card.card-total { border-left: 4px solid #3b82f6; }
    .client-summary-card.card-completed { border-left: 4px solid #10b981; }
    .client-summary-card.card-cancelled { border-left: 4px solid #ef4444; }
    .client-summary-card.card-complaints { border-left: 4px solid #f59e0b; }
    .summary-card-icon {
      font-size: 22px;
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: rgba(241, 245, 249, 0.8);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .summary-card-info {
      display: flex;
      flex-direction: column;
    }
    .summary-card-label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #64748b;
    }
    .summary-card-value {
      font-size: 18px;
      font-weight: 800;
      color: #0f172a;
      margin-top: 2px;
    }
    .system-theme.theme-dark .summary-card-value,
    body.dark .summary-card-value { color: #f8fafc; }

    /* Navigation Tabs */
    .client-view-tabs {
      display: flex;
      background: #f1f5f9;
      border-bottom: 1px solid #e2e8f0;
      padding: 0 16px;
      gap: 4px;
      overflow-x: auto;
    }
    .system-theme.theme-dark .client-view-tabs,
    body.dark .client-view-tabs {
      background: #1e293b;
      border-color: #334155;
    }
    .client-view-tab-btn {
      background: transparent;
      border: none;
      padding: 13px 18px;
      font-size: 13.5px;
      font-weight: 600;
      color: #64748b;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      border-bottom: 3px solid transparent;
      transition: all 0.2s ease;
      white-space: nowrap;
    }
    .client-view-tab-btn.active {
      color: #10b981;
      border-bottom-color: #10b981;
      background: #ffffff;
    }
    .system-theme.theme-dark .client-view-tab-btn.active,
    body.dark .client-view-tab-btn.active {
      color: #34d399;
      border-bottom-color: #34d399;
      background: #0f172a;
    }

    /* Tab Body */
    .client-view-body {
      padding: 20px 24px;
      overflow-y: auto;
      flex: 1;
    }
    .client-view-tab-content { display: none; }
    .client-view-tab-content.active { display: block; }

    /* Overview Grid */
    .client-overview-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      margin-bottom: 20px;
    }
    @media (max-width: 768px) {
      .client-overview-grid { grid-template-columns: repeat(1, 1fr); }
    }
    .client-info-group {
      background: #f8fafc;
      padding: 12px 16px;
      border-radius: 10px;
      border: 1px solid #e2e8f0;
    }
    .system-theme.theme-dark .client-info-group,
    body.dark .client-info-group {
      background: #182233;
      border-color: #334155;
    }
    .client-info-label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #64748b;
      display: block;
      margin-bottom: 4px;
    }
    .client-info-val {
      font-size: 14px;
      font-weight: 600;
      color: #0f172a;
    }
    .system-theme.theme-dark .client-info-val,
    body.dark .client-info-val { color: #f8fafc; }

    /* Overview Metrics Cards */
    .client-metrics-title {
      font-size: 15px;
      font-weight: 700;
      margin: 0 0 12px 0;
      color: #0f172a;
    }
    .system-theme.theme-dark .client-metrics-title,
    body.dark .client-metrics-title { color: #f8fafc; }
    .client-metrics-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 12px;
    }
    @media (max-width: 900px) {
      .client-metrics-grid { grid-template-columns: repeat(2, 1fr); }
    }
    .client-metric-card {
      padding: 14px;
      border-radius: 12px;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      text-align: center;
    }
    .system-theme.theme-dark .client-metric-card,
    body.dark .client-metric-card {
      background: #182233;
      border-color: #334155;
    }
    .client-metric-card .val {
      font-size: 20px;
      font-weight: 800;
      color: #0f172a;
    }
    .system-theme.theme-dark .client-metric-card .val,
    body.dark .client-metric-card .val { color: #f8fafc; }
    .client-metric-card .lbl {
      font-size: 11px;
      font-weight: 600;
      color: #64748b;
      margin-top: 4px;
    }

    /* All Orders Controls */
    .tab-controls-bar {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }
    .tab-controls-bar input,
    .tab-controls-bar select {
      padding: 8px 12px;
      border-radius: 8px;
      border: 1px solid #cbd5e1;
      font-size: 13px;
    }

    /* Tables */
    .client-tab-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13.5px;
    }
    .client-tab-table th,
    .client-tab-table td {
      padding: 12px 14px;
      text-align: left;
      border-bottom: 1px solid #e2e8f0;
    }
    .system-theme.theme-dark .client-tab-table th,
    .system-theme.theme-dark .client-tab-table td,
    body.dark .client-tab-table th,
    body.dark .client-tab-table td {
      border-color: #334155;
    }
    .client-tab-table th {
      background: #f8fafc;
      font-weight: 700;
      color: #475569;
    }
    .system-theme.theme-dark .client-tab-table th,
    body.dark .client-tab-table th {
      background: #1e293b;
      color: #cbd5e1;
    }

    /* Complaint resolution modal */
    .sub-modal-card {
      background: #ffffff;
      width: 100%;
      max-width: 520px;
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
    }
    .system-theme.theme-dark .sub-modal-card,
    body.dark .sub-modal-card {
      background: #0f172a;
      color: #f8fafc;
    }
  </style></head>
<body class="system-theme">
  <%- include('partials/system_sidebar', { shell }) %>

  <main class="system-main">
    <header class="topbar">
      <div>
        <p class="crumb">Dashboard / Clients</p>
        <h1>Client Management</h1>
      </div>
      <div class="topbar-actions">
        <label class="system-search" aria-label="Search clients">
          <input id="clientSearch" type="search" placeholder="Search clients" />
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
        </label>
      </div>
    </header>

    <section class="vendor-management-shell">
      <div class="users-toolbar">
        <div>
          <h2>All Clients</h2>
          <p>Register clients, update profile details, and control account status.</p>
        </div>
        <div class="vendor-toolbar-actions">
          <label>
            Country
            <select id="countryFilter"></select>
          </label>
          <label>
            State
            <select id="stateFilter"></select>
          </label>
          <label>
            City
            <select id="cityFilter"></select>
          </label>
          <label>
            Status
            <select id="statusFilter">
              <option value="">All Status</option>
              <option value="active">active</option>
              <option value="inactive">inactive</option>
            </select>
          </label>
          <button class="product-secondary-button" type="button" id="clearClientFilters">Clear</button>
          <button class="settings-save" type="button" id="addClientButton">Add New Client</button>
        </div>
      </div>

      <div class="users-table-card">
        <table class="users-table clients-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Client</th>
              <th>Phone</th>
              <th>Location</th>
              <th>Area</th>
              <th>Age</th>
              <th>Gender</th>
              <th>COD Limit</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="clientsTableBody">
            <tr><td colspan="10">Loading clients...</td></tr>
          </tbody>
        </table>
      </div>

      <div class="users-pagination">
        <button type="button" id="prevPage">Previous</button>
        <span id="pageInfo">Page 1</span>
        <button type="button" id="nextPage">Next</button>
      </div>
    </section>
  </main>

  <div class="user-modal" id="clientModal" aria-hidden="true">
    <div class="user-modal-card">
      <div class="user-modal-header">
        <h2 id="clientModalTitle">Add Client</h2>
        <button type="button" onclick="closeClientModal()">Close</button>
      </div>
      <form id="clientForm" class="user-modal-grid">
        <input type="hidden" id="clientId" />
        <label>
          Name
          <input id="clientName" type="text" required minlength="2" />
        </label>
        <label>
          Email
          <input id="clientEmail" type="email" required />
        </label>
        <label>
          Phone
          <input id="clientPhone" type="text" required />
        </label>
        <label>
          Password
          <input id="clientPassword" type="password" minlength="6" />
        </label>
        <label>
          Status
          <select id="clientStatus" required>
            <option value="active">active</option>
            <option value="inactive">inactive</option>
          </select>
        </label>
        <label>
          Age
          <input id="clientAge" type="number" min="1" max="120" />
        </label>
        <label>
          Gender
          <select id="clientGender">
            <option value="">Select Gender</option>
            <option value="Female">Female</option>
            <option value="Male">Male</option>
            <option value="Other">Other</option>
          </select>
        </label>
        <label>
          COD Limit
          <input id="clientCodLimit" type="number" min="0" step="0.01" value="0" />
        </label>
        <label>
          Country
          <select id="clientCountry" required></select>
        </label>
        <label>
          State
          <select id="clientState" required></select>
        </label>
        <label>
          City
          <select id="clientCity" required></select>
        </label>
        <label>
          Area
          <select id="clientArea" required><option value="">Select Area</option></select>
        </label>
        <label class="settings-wide">
          Address
          <textarea id="clientAddress" rows="3"></textarea>
        </label>
        <label class="settings-wide">
          Notes
          <textarea id="clientNotes" rows="3"></textarea>
        </label>
        <button class="settings-save" type="submit" id="clientSubmit">Save Client</button>
      </form>
    </div>
  </div>

  <div class="user-modal" id="deleteClientModal" aria-hidden="true">
    <div class="confirm-card">
      <h2>Delete client?</h2>
      <div class="confirm-actions">
        <button type="button" id="deleteClientYes">Yes</button>
        <button type="button" id="deleteClientNo">No</button>
      </div>
    </div>
  </div>

  <!-- Centered Client Profile View Modal -->
  <div class="client-view-overlay" id="clientViewModal" aria-hidden="true">
    <div class="client-view-card">
      <!-- Modal Header -->
      <div class="client-view-header">
        <div class="client-profile-summary">
          <div class="client-avatar-wrapper" id="clientViewAvatar">
            <span>C</span>
          </div>
          <div class="client-header-details">
            <h2 id="clientViewHeaderName">Client Name</h2>
            <div class="client-header-meta">
              <span id="clientViewHeaderStatus" class="user-status-pill active">active</span>
              <span id="clientViewHeaderLocation" class="client-location-badge">Jaipur, Rajasthan</span>
            </div>
          </div>
        </div>
        <button type="button" class="vendor-modal-close-btn" onclick="closeClientViewModal()" aria-label="Close modal">&times;</button>
      </div>

      <!-- 4 Top Clickable Summary Cards -->
      <div class="client-top-summary-grid">
        <div class="client-summary-card card-total" onclick="switchClientViewTab('all-orders')">
          <div class="summary-card-icon">📦</div>
          <div class="summary-card-info">
            <span class="summary-card-label">Total Orders</span>
            <span class="summary-card-value" id="statClientTotalOrders">0</span>
          </div>
        </div>
        <div class="client-summary-card card-completed" onclick="switchClientViewTab('completed-orders')">
          <div class="summary-card-icon">✅</div>
          <div class="summary-card-info">
            <span class="summary-card-label">Completed Orders</span>
            <span class="summary-card-value" id="statClientCompletedOrders">0</span>
          </div>
        </div>
        <div class="client-summary-card card-cancelled" onclick="switchClientViewTab('cancelled-orders')">
          <div class="summary-card-icon">🚫</div>
          <div class="summary-card-info">
            <span class="summary-card-label">Cancelled Orders</span>
            <span class="summary-card-value" id="statClientCancelledOrders">0</span>
          </div>
        </div>
        <div class="client-summary-card card-complaints" onclick="switchClientViewTab('complaints')">
          <div class="summary-card-icon">💬</div>
          <div class="summary-card-info">
            <span class="summary-card-label">Complaints</span>
            <span class="summary-card-value" id="statClientComplaints">0</span>
          </div>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <nav class="client-view-tabs">
        <button type="button" class="client-view-tab-btn active" data-client-tab="overview" onclick="switchClientViewTab('overview')">
          👤 Overview
        </button>
        <button type="button" class="client-view-tab-btn" data-client-tab="all-orders" onclick="switchClientViewTab('all-orders')">
          📦 All Orders
        </button>
        <button type="button" class="client-view-tab-btn" data-client-tab="cancelled-orders" onclick="switchClientViewTab('cancelled-orders')">
          🚫 Cancelled Orders
        </button>
        <button type="button" class="client-view-tab-btn" data-client-tab="completed-orders" onclick="switchClientViewTab('completed-orders')">
          ✅ Completed Orders
        </button>
        <button type="button" class="client-view-tab-btn" data-client-tab="complaints" onclick="switchClientViewTab('complaints')">
          💬 Complaints
        </button>
      </nav>

      <!-- Tab Body -->
      <div class="client-view-body">
        <div id="clientViewLoading" style="display:none; text-align:center; padding: 40px;">
          <p>Loading client details...</p>
        </div>

        <!-- TAB 1: OVERVIEW -->
        <div class="client-view-tab-content active" id="clientTabOverview">
          <div class="client-overview-grid">
            <div class="client-info-group">
              <span class="client-info-label">Client Name</span>
              <span class="client-info-val" id="viewClientName">-</span>
            </div>
            <div class="client-info-group">
              <span class="client-info-label">Phone Number</span>
              <span class="client-info-val" id="viewClientPhone">-</span>
            </div>
            <div class="client-info-group">
              <span class="client-info-label">Email Address</span>
              <span class="client-info-val" id="viewClientEmail">-</span>
            </div>
            <div class="client-info-group">
              <span class="client-info-label">Registration Date</span>
              <span class="client-info-val" id="viewClientRegDate">-</span>
            </div>
            <div class="client-info-group">
              <span class="client-info-label">City & Area</span>
              <span class="client-info-val" id="viewClientLocation">-</span>
            </div>
            <div class="client-info-group">
              <span class="client-info-label">Account Status</span>
              <span class="client-info-val" id="viewClientStatus">-</span>
            </div>
            <div class="client-info-group">
              <span class="client-info-label">Wallet Balance</span>
              <span class="client-info-val" id="viewClientWallet" style="color: #10b981; font-weight:800;">₹0.00</span>
            </div>
            <div class="client-info-group">
              <span class="client-info-label">COD Limit</span>
              <span class="client-info-val" id="viewClientCodLimit">₹0.00</span>
            </div>
            <div class="client-info-group">
              <span class="client-info-label">Address</span>
              <span class="client-info-val" id="viewClientAddress">-</span>
            </div>
          </div>

          <h3 class="client-metrics-title">📊 Order Summary Overview</h3>
          <div class="client-metrics-grid">
            <div class="client-metric-card">
              <div class="val" id="metricTotalOrders">0</div>
              <div class="lbl">Total Orders</div>
            </div>
            <div class="client-metric-card">
              <div class="val" id="metricCompletedOrders" style="color:#10b981;">0</div>
              <div class="lbl">Successfully Completed</div>
            </div>
            <div class="client-metric-card">
              <div class="val" id="metricCancelledOrders" style="color:#ef4444;">0</div>
              <div class="lbl">Cancelled Orders</div>
            </div>
            <div class="client-metric-card">
              <div class="val" id="metricActiveOrders" style="color:#3b82f6;">0</div>
              <div class="lbl">Active / Pending</div>
            </div>
            <div class="client-metric-card">
              <div class="val" id="metricReturnedOrders" style="color:#f59e0b;">0</div>
              <div class="lbl">Returned / Refunded</div>
            </div>
          </div>
        </div>

        <!-- TAB 2: ALL ORDERS -->
        <div class="client-view-tab-content" id="clientTabAllOrders">
          <div class="tab-controls-bar">
            <input type="text" id="clientOrderSearchInput" placeholder="Search order ID, vendor..." oninput="onClientOrderSearchChange()" />
            <select id="clientOrderStatusSelect" onchange="onClientOrderFilterChange()">
              <option value="">All Statuses</option>
              <option value="pending">Pending</option>
              <option value="confirmed">Confirmed</option>
              <option value="processing">Processing</option>
              <option value="ready_for_pickup">Ready for Pickup</option>
              <option value="out_for_delivery">Out for Delivery</option>
              <option value="delivered">Delivered</option>
              <option value="completed">Completed</option>
              <option value="cancelled">Cancelled</option>
              <option value="rejected">Rejected</option>
            </select>
            <select id="clientOrderSortSelect" onchange="onClientOrderFilterChange()">
              <option value="date_desc">Newest First</option>
              <option value="date_asc">Oldest First</option>
              <option value="amount_desc">Amount High -> Low</option>
              <option value="amount_asc">Amount Low -> High</option>
            </select>
          </div>

          <table class="client-tab-table">
            <thead>
              <tr>
                <th>Order ID</th>
                <th>Vendor Name</th>
                <th>Order Amount</th>
                <th>Payment Method</th>
                <th>Order Date</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="clientAllOrdersTbody">
              <tr><td colspan="7">No orders placed yet</td></tr>
            </tbody>
          </table>
          <div style="margin-top: 14px; display:flex; justify-content:space-between; align-items:center;">
            <span id="allOrdersPageInfo" style="font-size:12px; font-weight:600; color:#64748b;">Page 1</span>
            <div>
              <button type="button" id="allOrdersPrevBtn" onclick="prevAllOrdersPage()" style="padding:4px 10px; border-radius:6px; font-size:12px;">Prev</button>
              <button type="button" id="allOrdersNextBtn" onclick="nextAllOrdersPage()" style="padding:4px 10px; border-radius:6px; font-size:12px;">Next</button>
            </div>
          </div>
        </div>

        <!-- TAB 3: CANCELLED ORDERS -->
        <div class="client-view-tab-content" id="clientTabCancelledOrders">
          <table class="client-tab-table">
            <thead>
              <tr>
                <th>Order ID</th>
                <th>Vendor Name</th>
                <th>Amount</th>
                <th>Cancellation Date</th>
                <th>Cancelled By</th>
                <th>Cancellation Reason</th>
              </tr>
            </thead>
            <tbody id="clientCancelledOrdersTbody">
              <tr><td colspan="6">No cancelled orders</td></tr>
            </tbody>
          </table>
        </div>

        <!-- TAB 4: COMPLETED ORDERS -->
        <div class="client-view-tab-content" id="clientTabCompletedOrders">
          <table class="client-tab-table">
            <thead>
              <tr>
                <th>Order ID</th>
                <th>Order Date</th>
                <th>Delivery Date</th>
                <th>Vendor</th>
                <th>Delivery Partner</th>
                <th>Payment Status</th>
                <th>Total Amount</th>
              </tr>
            </thead>
            <tbody id="clientCompletedOrdersTbody">
              <tr><td colspan="7">No completed orders</td></tr>
            </tbody>
          </table>
        </div>

        <!-- TAB 5: COMPLAINTS -->
        <div class="client-view-tab-content" id="clientTabComplaints">
          <table class="client-tab-table">
            <thead>
              <tr>
                <th>Complaint ID</th>
                <th>Related Order ID</th>
                <th>Category</th>
                <th>Description</th>
                <th>Created Date</th>
                <th>Assigned Staff</th>
                <th>Status</th>
                <th>Resolution</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="clientComplaintsTbody">
              <tr><td colspan="9">No complaints raised</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Order Detail Preview Sub-Modal -->
  <div class="client-view-overlay" id="clientOrderDetailModal" style="z-index: 1300;" aria-hidden="true">
    <div class="sub-modal-card" style="max-width: 680px;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
        <h3 id="orderDetailModalTitle" style="margin:0; font-size:18px;">Order Details</h3>
        <button type="button" onclick="closeClientOrderDetailModal()" style="border:none; background:transparent; font-size:22px; cursor:pointer;">&times;</button>
      </div>
      <div id="orderDetailModalBody" style="max-height: 60vh; overflow-y:auto; font-size:13.5px;">
        <p>Loading details...</p>
      </div>
    </div>
  </div>

  <!-- Complaint Resolution Sub-Modal -->
  <div class="client-view-overlay" id="clientComplaintResolveModal" style="z-index: 1300;" aria-hidden="true">
    <div class="sub-modal-card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
        <h3 style="margin:0; font-size:18px;">Update Complaint & Resolution</h3>
        <button type="button" onclick="closeClientComplaintResolveModal()" style="border:none; background:transparent; font-size:22px; cursor:pointer;">&times;</button>
      </div>
      <form id="complaintResolveForm" onsubmit="submitComplaintResolution(event)" style="display:flex; flex-direction:column; gap:14px;">
        <input type="hidden" id="resolveComplaintId" />
        <label style="font-weight:600; font-size:13px;">
          Complaint Status
          <select id="resolveStatus" required style="width:100%; padding:8px; border-radius:8px; border:1px solid #cbd5e1; margin-top:4px;">
            <option value="Open">Open</option>
            <option value="In Progress">In Progress</option>
            <option value="Resolved">Resolved</option>
            <option value="Closed">Closed</option>
          </select>
        </label>
        <label style="font-weight:600; font-size:13px;">
          Resolution Notes
          <textarea id="resolveNotes" rows="4" placeholder="Enter resolution notes or staff comments..." required style="width:100%; padding:8px; border-radius:8px; border:1px solid #cbd5e1; margin-top:4px;"></textarea>
        </label>
        <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:10px;">
          <button type="button" onclick="closeClientComplaintResolveModal()" style="padding:8px 16px; border-radius:8px; border:1px solid #cbd5e1; background:transparent; cursor:pointer;">Cancel</button>
          <button type="submit" style="padding:8px 16px; border-radius:8px; border:none; background:#10b981; color:#fff; font-weight:700; cursor:pointer;">Save Resolution</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const locationOptions = <%- JSON.stringify(locationOptions) %>;
    let areaOptions = [];
    let pendingClientArea = '';
    let clients = [];
    let currentPage = 1;
    let totalPages = 1;
    let pendingDeleteId = null;

    const tableBody = document.getElementById('clientsTableBody');
    const clientSearch = document.getElementById('clientSearch');
    const statusFilter = document.getElementById('statusFilter');
    const countryFilter = document.getElementById('countryFilter');
    const stateFilter = document.getElementById('stateFilter');
    const cityFilter = document.getElementById('cityFilter');
    const pageInfo = document.getElementById('pageInfo');
    const prevPage = document.getElementById('prevPage');
    const nextPage = document.getElementById('nextPage');

    function debounce(fn, delay) {
      let timer;
      return (...args) => {
        clearTimeout(timer);
        timer = setTimeout(() => fn(...args), delay);
      };
    }

    function escapeHtml(value) {
      return String(value || '').replace(/[&<>"']/g, (char) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;',
      }[char]));
    }

    function optionList(items, emptyLabel) {
      return `<option value="">${emptyLabel}</option>` + items
        .map((item) => `<option value="${escapeHtml(item)}">${escapeHtml(item)}</option>`)
        .join('');
    }

    function updateStateOptions(selectedState) {
      const country = document.getElementById('clientCountry').value;
      const states = country && locationOptions.tree[country] ? Object.keys(locationOptions.tree[country]) : [];
      const stateSelect = document.getElementById('clientState');
      stateSelect.innerHTML = optionList(states, 'Select State');
      if (selectedState) stateSelect.value = selectedState;
      updateCityOptions();
    }

    function updateCityOptions(selectedCity) {
      const country = document.getElementById('clientCountry').value;
      const state = document.getElementById('clientState').value;
      const cities = country && state && locationOptions.tree[country] && locationOptions.tree[country][state]
        ? locationOptions.tree[country][state]
        : [];
      const citySelect = document.getElementById('clientCity');
      citySelect.innerHTML = optionList(cities, 'Select City');
      if (selectedCity) citySelect.value = selectedCity;
      updateAreaOptions();
    }

    function updateAreaOptions(selectedArea = pendingClientArea) {
      const city = document.getElementById('clientCity').value.trim().toLowerCase();
      const areas = areaOptions
        .filter((item) => String(item.city || '').trim().toLowerCase() === city)
        .map((item) => item.area);
      const select = document.getElementById('clientArea');
      select.innerHTML = optionList(areas, areas.length ? 'Select Area' : 'No defined areas for this city');
      select.disabled = !areas.length;
      if (selectedArea) select.value = selectedArea;
    }

    async function loadAreaOptions() {
      const response = await fetch('/area-options', { headers: { Accept: 'application/json' } });
      const data = await response.json();
      areaOptions = data.success ? data.areas || [] : [];
      updateAreaOptions();
    }

    function renderLocationOptions() {
      document.getElementById('clientCountry').innerHTML = optionList(locationOptions.countries, 'Select Country');
      updateStateOptions();
    }

    function updateFilterStates(selectedState) {
      const country = countryFilter.value;
      const states = country && locationOptions.tree[country] ? Object.keys(locationOptions.tree[country]) : locationOptions.states;
      stateFilter.innerHTML = optionList(states, 'All States');
      if (selectedState) stateFilter.value = selectedState;
      updateFilterCities();
    }

    function updateFilterCities(selectedCity) {
      const country = countryFilter.value;
      const state = stateFilter.value;
      let cities = locationOptions.cities;
      if (country && state && locationOptions.tree[country] && locationOptions.tree[country][state]) {
        cities = locationOptions.tree[country][state];
      } else if (country && locationOptions.tree[country]) {
        cities = [...new Set(Object.values(locationOptions.tree[country]).flat())];
      }
      cityFilter.innerHTML = optionList(cities, 'All Cities');
      if (selectedCity) cityFilter.value = selectedCity;
    }

    function renderFilterOptions() {
      countryFilter.innerHTML = optionList(locationOptions.countries, 'All Countries');
      updateFilterStates();
      updateFilterCities();
    }

    function clientLocation(client) {
      return [client.city, client.state].filter(Boolean).join(', ') || '-';
    }

    async function loadClients(page = 1) {
      const params = new URLSearchParams({
        format: 'json',
        page,
        limit: 10,
        search: clientSearch.value.trim(),
        status: statusFilter.value,
        country: countryFilter.value,
        state: stateFilter.value,
        city: cityFilter.value,
      });
      const response = await fetch(`/clients?${params.toString()}`, { headers: { Accept: 'application/json' } });
      const data = await response.json();
      if (!data.success) {
        tableBody.innerHTML = `<tr><td colspan="10">${escapeHtml(data.message || 'Unable to load clients')}</td></tr>`;
        return;
      }
      clients = data.clients || [];
      currentPage = data.pagination.page;
      totalPages = data.pagination.totalPages;
      renderClients();
    }

    function renderClients() {
      if (!clients.length) {
        tableBody.innerHTML = '<tr><td colspan="10">No clients found</td></tr>';
      } else {
        tableBody.innerHTML = clients.map((client) => `
          <tr>
            <td>#${client.id}</td>
            <td>
              <strong>${escapeHtml(client.name)}</strong>
              <span class="vendor-subtext">${escapeHtml(client.email)}</span>
            </td>
            <td>${escapeHtml(client.phone)}</td>
            <td>${escapeHtml(clientLocation(client))}</td>
            <td>${escapeHtml(client.area || '-')}</td>
            <td>${escapeHtml(client.age || '-')}</td>
            <td>${escapeHtml(client.gender || '-')}</td>
            <td>Rs ${Number(client.cod_limit || 0).toFixed(2)}</td>
            <td><span class="user-status-pill ${client.status === 'active' ? 'active' : 'inactive'}">${escapeHtml(client.status)}</span></td>
            <td>
              <div class="user-actions">
                ${typeof canViewClientDetails !== 'undefined' && canViewClientDetails ? `<button type="button" class="vendor-view-btn" onclick="openClientViewModal(${client.id})">View</button>` : '<button type="button" class="vendor-view-btn" onclick="openClientViewModal(' + client.id + ')">View</button>'}
                <button type="button" onclick="toggleClientStatus(${client.id})">${client.status === 'active' ? 'Deactivate' : 'Active'}</button>
                <button type="button" onclick="openEditClient(${client.id})">Edit</button>
                <button type="button" onclick="changeClientArea(${client.id})">Change Area</button>
                <button type="button" onclick="askDeleteClient(${client.id})">Delete</button>
              </div>
            </td>
          </tr>
        `).join('');
      }

      pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
      prevPage.disabled = currentPage <= 1;
      nextPage.disabled = currentPage >= totalPages;
    }

    function openClientModal() {
      document.getElementById('clientModal').classList.add('active');
    }

    function closeClientModal() {
      document.getElementById('clientModal').classList.remove('active');
    }

    function resetClientForm() {
      pendingClientArea = '';
      document.getElementById('clientForm').reset();
      document.getElementById('clientId').value = '';
      document.getElementById('clientPassword').required = true;
      document.getElementById('clientCodLimit').value = '0';
      document.getElementById('clientModalTitle').textContent = 'Add Client';
      document.getElementById('clientSubmit').textContent = 'Save Client';
      renderLocationOptions();
    }

    function openAddClient() {
      resetClientForm();
      openClientModal();
    }

    function changeClientArea(id) {
      openEditClient(id);
      setTimeout(() => document.getElementById('clientArea').focus(), 0);
    }

    function openEditClient(id) {
      const client = clients.find((item) => item.id === id);
      if (!client) return;
      document.getElementById('clientId').value = client.id;
      document.getElementById('clientName').value = client.name;
      document.getElementById('clientEmail').value = client.email;
      document.getElementById('clientPhone').value = client.phone;
      document.getElementById('clientPassword').value = '';
      document.getElementById('clientPassword').required = false;
      document.getElementById('clientStatus').value = client.status;
      document.getElementById('clientAge').value = client.age || '';
      document.getElementById('clientGender').value = client.gender || '';
      document.getElementById('clientCodLimit').value = Number(client.cod_limit || 0);
      document.getElementById('clientCountry').value = client.country || '';
      pendingClientArea = client.area || '';
      updateStateOptions(client.state || '');
      updateCityOptions(client.city || '');
      updateAreaOptions(client.area || '');
      document.getElementById('clientAddress').value = client.address || '';
      document.getElementById('clientNotes').value = client.notes || '';
      document.getElementById('clientModalTitle').textContent = 'Edit Client';
      document.getElementById('clientSubmit').textContent = 'Update Client';
      openClientModal();
    }

    async function toggleClientStatus(id) {
      const client = clients.find((item) => item.id === id);
      if (!client) return;
      const nextStatus = client.status === 'active' ? 'inactive' : 'active';
      const response = await fetch(`/clients/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: nextStatus }),
      });
      const data = await response.json();
      if (!data.success) {
        alert(data.message || 'Unable to update client status');
        return;
      }
      loadClients(currentPage);
    }

    function askDeleteClient(id) {
      pendingDeleteId = id;
      document.getElementById('deleteClientModal').classList.add('active');
    }

    async function deleteClient() {
      if (!pendingDeleteId) return;
      const id = pendingDeleteId;
      pendingDeleteId = null;
      document.getElementById('deleteClientModal').classList.remove('active');
      const response = await fetch(`/clients/${id}`, { method: 'DELETE' });
      const data = await response.json();
      if (!data.success) {
        alert(data.message || 'Unable to delete client');
        return;
      }
      loadClients(currentPage);
    }

    document.getElementById('clientForm').addEventListener('submit', async (event) => {
      event.preventDefault();
      const id = document.getElementById('clientId').value;
      const payload = {
        name: document.getElementById('clientName').value,
        email: document.getElementById('clientEmail').value,
        phone: document.getElementById('clientPhone').value,
        password: document.getElementById('clientPassword').value,
        status: document.getElementById('clientStatus').value,
        age: document.getElementById('clientAge').value,
        gender: document.getElementById('clientGender').value,
        cod_limit: Number(document.getElementById('clientCodLimit').value || 0),
        country: document.getElementById('clientCountry').value,
        state: document.getElementById('clientState').value,
        city: document.getElementById('clientCity').value,
        area: document.getElementById('clientArea').value,
        address: document.getElementById('clientAddress').value,
        notes: document.getElementById('clientNotes').value,
      };
      if (id && !payload.password) delete payload.password;

      const response = await fetch(`/clients${id ? `/${id}` : ''}`, {
        method: id ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await response.json();
      if (!data.success) {
        alert((data.errors || []).join(', ') || data.message || 'Unable to save client');
        return;
      }
      closeClientModal();
      resetClientForm();
      loadClients(id ? currentPage : 1);
    });

    document.getElementById('addClientButton').addEventListener('click', openAddClient);
    document.getElementById('clientCountry').addEventListener('change', () => updateStateOptions());
    document.getElementById('clientState').addEventListener('change', () => updateCityOptions());
    document.getElementById('clientCity').addEventListener('change', () => { pendingClientArea = ''; updateAreaOptions(); });
    document.getElementById('deleteClientYes').addEventListener('click', deleteClient);
    document.getElementById('deleteClientNo').addEventListener('click', () => {
      pendingDeleteId = null;
      document.getElementById('deleteClientModal').classList.remove('active');
    });
    clientSearch.addEventListener('input', debounce(() => loadClients(1), 300));
    statusFilter.addEventListener('change', () => loadClients(1));
    countryFilter.addEventListener('change', () => {
      updateFilterStates();
      updateFilterCities();
      loadClients(1);
    });
    stateFilter.addEventListener('change', () => {
      updateFilterCities();
      loadClients(1);
    });
    cityFilter.addEventListener('change', () => loadClients(1));
    document.getElementById('clearClientFilters').addEventListener('click', () => {
      clientSearch.value = '';
      statusFilter.value = '';
      countryFilter.value = '';
      updateFilterStates();
      updateFilterCities();
      loadClients(1);
    });
    prevPage.addEventListener('click', () => loadClients(currentPage - 1));
    nextPage.addEventListener('click', () => loadClients(currentPage + 1));

    renderLocationOptions();
    loadAreaOptions();
    renderFilterOptions();
    loadClients();

    // CLIENT PROFILE VIEW MODAL LOGIC
    let currentViewClientId = null;
    let clientViewData = null;
    let allOrdersCurrentPage = 1;
    const allOrdersPageSize = 5;

    function formatCurrency(val) {
      return '₹' + Number(val || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function formatDate(dateStr) {
      if (!dateStr) return '-';
      try {
        const d = new Date(dateStr);
        if (isNaN(d.getTime())) return String(dateStr);
        return d.toLocaleString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
      } catch (e) {
        return String(dateStr);
      }
    }

    function statusBadgeHtml(status) {
      const val = String(status || '').toLowerCase();
      let colorClass = 'inactive';
      if (['active', 'approved', 'delivered', 'completed', 'paid', 'resolved'].includes(val)) colorClass = 'active';
      if (['pending', 'confirmed', 'processing', 'ready_for_pickup', 'out_for_delivery', 'in progress', 'open'].includes(val)) colorClass = 'pending';
      return `<span class="user-status-pill ${colorClass}">${escapeHtml(status)}</span>`;
    }

    async function openClientViewModal(id) {
      currentViewClientId = id;
      const modal = document.getElementById('clientViewModal');
      const loading = document.getElementById('clientViewLoading');
      switchClientViewTab('overview');
      modal.classList.add('active');
      loading.innerHTML = '<p>Loading client details...</p>';
      loading.style.display = 'block';

      try {
        const response = await fetch(`/clients/${id}/full-details`, { headers: { Accept: 'application/json' } });
        const data = await response.json();

        if (!data.success || !data.client) {
          loading.innerHTML = `<p style="color:#ef4444; font-weight:700;">${escapeHtml(data.message || 'Unable to load client details')}</p>`;
          return;
        }

        loading.style.display = 'none';
        clientViewData = data.client;
        populateClientViewModal();
      } catch (err) {
        console.error('Client details fetch error:', err);
        loading.innerHTML = '<p style="color:#ef4444; font-weight:700;">Failed to connect to server</p>';
      }
    }

    function closeClientViewModal() {
      document.getElementById('clientViewModal').classList.remove('active');
      currentViewClientId = null;
      clientViewData = null;
    }

    function switchClientViewTab(tabName) {
      document.querySelectorAll('.client-view-tab-btn').forEach((btn) => {
        btn.classList.toggle('active', btn.getAttribute('data-client-tab') === tabName);
      });
      document.querySelectorAll('.client-view-tab-content').forEach((content) => {
        content.classList.remove('active');
      });

      const targetTab = {
        'overview': 'clientTabOverview',
        'all-orders': 'clientTabAllOrders',
        'cancelled-orders': 'clientTabCancelledOrders',
        'completed-orders': 'clientTabCompletedOrders',
        'complaints': 'clientTabComplaints',
      }[tabName] || 'clientTabOverview';

      const tabEl = document.getElementById(targetTab);
      if (tabEl) tabEl.classList.add('active');
    }

    function populateClientViewModal() {
      if (!clientViewData) return;
      const { profile, stats, orders, cancelled_orders, completed_orders, complaints } = clientViewData;

      // Header
      document.getElementById('clientViewHeaderName').textContent = profile.name || 'Client';
      document.getElementById('clientViewHeaderStatus').textContent = profile.status || 'active';
      document.getElementById('clientViewHeaderStatus').className = `user-status-pill ${profile.status === 'active' ? 'active' : 'inactive'}`;
      document.getElementById('clientViewHeaderLocation').textContent = [profile.city, profile.state].filter(Boolean).join(', ') || 'India';

      const avatar = document.getElementById('clientViewAvatar');
      const initial = (profile.name || 'C').charAt(0).toUpperCase();
      avatar.innerHTML = `<span>${initial}</span>`;

      // Top 4 Summary Cards
      document.getElementById('statClientTotalOrders').textContent = stats.total_orders;
      document.getElementById('statClientCompletedOrders').textContent = stats.completed_orders;
      document.getElementById('statClientCancelledOrders').textContent = stats.cancelled_orders;
      document.getElementById('statClientComplaints').textContent = stats.total_complaints;

      // TAB 1: OVERVIEW
      document.getElementById('viewClientName').textContent = profile.name || '-';
      document.getElementById('viewClientPhone').textContent = profile.phone || '-';
      document.getElementById('viewClientEmail').textContent = profile.email || '-';
      document.getElementById('viewClientRegDate').textContent = formatDate(profile.created_at);
      document.getElementById('viewClientLocation').textContent = [profile.area, profile.city, profile.state].filter(Boolean).join(', ') || '-';
      document.getElementById('viewClientStatus').textContent = profile.status || '-';
      document.getElementById('viewClientWallet').textContent = formatCurrency(profile.wallet_balance);
      document.getElementById('viewClientCodLimit').textContent = formatCurrency(profile.cod_limit);
      document.getElementById('viewClientAddress').textContent = profile.address || '-';

      // Summary Metric Cards
      document.getElementById('metricTotalOrders').textContent = stats.total_orders;
      document.getElementById('metricCompletedOrders').textContent = stats.completed_orders;
      document.getElementById('metricCancelledOrders').textContent = stats.cancelled_orders;
      document.getElementById('metricActiveOrders').textContent = stats.active_pending_orders;
      document.getElementById('metricReturnedOrders').textContent = stats.returned_refunded_orders;

      // Render Sub-tabs
      allOrdersCurrentPage = 1;
      renderAllOrdersTab();
      renderCancelledOrdersTab();
      renderCompletedOrdersTab();
      renderComplaintsTab();
    }

    function renderAllOrdersTab() {
      if (!clientViewData) return;
      const rawOrders = clientViewData.orders || [];
      const search = document.getElementById('clientOrderSearchInput').value.trim().toLowerCase();
      const status = document.getElementById('clientOrderStatusSelect').value;
      const sort = document.getElementById('clientOrderSortSelect').value;

      let filtered = rawOrders.filter((o) => {
        const matchesSearch = !search || String(o.id).includes(search) || String(o.order_number).toLowerCase().includes(search) || String(o.vendor_name).toLowerCase().includes(search);
        const matchesStatus = !status || String(o.status).toLowerCase() === status.toLowerCase();
        return matchesSearch && matchesStatus;
      });

      if (sort === 'date_desc') filtered.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
      if (sort === 'date_asc') filtered.sort((a, b) => new Date(a.created_at) - new Date(b.created_at));
      if (sort === 'amount_desc') filtered.sort((a, b) => b.total_amount - a.total_amount);
      if (sort === 'amount_asc') filtered.sort((a, b) => a.total_amount - b.total_amount);

      const totalPages = Math.max(1, Math.ceil(filtered.length / allOrdersPageSize));
      if (allOrdersCurrentPage > totalPages) allOrdersCurrentPage = totalPages;

      const start = (allOrdersCurrentPage - 1) * allOrdersPageSize;
      const pageOrders = filtered.slice(start, start + allOrdersPageSize);

      const tbody = document.getElementById('clientAllOrdersTbody');
      if (!pageOrders.length) {
        tbody.innerHTML = '<tr><td colspan="7">No matching orders found</td></tr>';
      } else {
        tbody.innerHTML = pageOrders.map((o) => `
          <tr>
            <td><strong>${escapeHtml(o.order_number || `#${o.id}`)}</strong></td>
            <td>${escapeHtml(o.vendor_name)}</td>
            <td><strong>${formatCurrency(o.total_amount)}</strong></td>
            <td>${escapeHtml(o.payment_method)} (${escapeHtml(o.payment_status)})</td>
            <td>${formatDate(o.created_at)}</td>
            <td>${statusBadgeHtml(o.status)}</td>
            <td><button type="button" class="vendor-view-btn" onclick="openClientOrderDetailModal(${o.id})">Details</button></td>
          </tr>
        `).join('');
      }

      document.getElementById('allOrdersPageInfo').textContent = `Page ${allOrdersCurrentPage} of ${totalPages} (${filtered.length} orders)`;
      document.getElementById('allOrdersPrevBtn').disabled = allOrdersCurrentPage <= 1;
      document.getElementById('allOrdersNextBtn').disabled = allOrdersCurrentPage >= totalPages;
    }

    function onClientOrderSearchChange() {
      allOrdersCurrentPage = 1;
      renderAllOrdersTab();
    }

    function onClientOrderFilterChange() {
      allOrdersCurrentPage = 1;
      renderAllOrdersTab();
    }

    function prevAllOrdersPage() {
      if (allOrdersCurrentPage > 1) {
        allOrdersCurrentPage--;
        renderAllOrdersTab();
      }
    }

    function nextAllOrdersPage() {
      allOrdersCurrentPage++;
      renderAllOrdersTab();
    }

    function renderCancelledOrdersTab() {
      if (!clientViewData) return;
      const cancelled = clientViewData.cancelled_orders || [];
      const tbody = document.getElementById('clientCancelledOrdersTbody');
      if (!cancelled.length) {
        tbody.innerHTML = '<tr><td colspan="6">No cancelled orders</td></tr>';
      } else {
        tbody.innerHTML = cancelled.map((o) => `
          <tr>
            <td><strong>${escapeHtml(o.order_number || `#${o.id}`)}</strong></td>
            <td>${escapeHtml(o.vendor_name)}</td>
            <td>${formatCurrency(o.total_amount)}</td>
            <td>${formatDate(o.cancelled_at || o.status_updated_at || o.created_at)}</td>
            <td><span class="user-status-pill pending">${escapeHtml(o.cancelled_by || 'Client')}</span></td>
            <td>${escapeHtml(o.cancellation_reason || 'Cancelled by client')}</td>
          </tr>
        `).join('');
      }
    }

    function renderCompletedOrdersTab() {
      if (!clientViewData) return;
      const completed = clientViewData.completed_orders || [];
      const tbody = document.getElementById('clientCompletedOrdersTbody');
      if (!completed.length) {
        tbody.innerHTML = '<tr><td colspan="7">No completed orders</td></tr>';
      } else {
        tbody.innerHTML = completed.map((o) => `
          <tr>
            <td><strong>${escapeHtml(o.order_number || `#${o.id}`)}</strong></td>
            <td>${formatDate(o.created_at)}</td>
            <td>${formatDate(o.delivered_at || o.status_updated_at)}</td>
            <td>${escapeHtml(o.vendor_name)}</td>
            <td>${escapeHtml(o.delivery_partner_name)}</td>
            <td><span class="user-status-pill active">${escapeHtml(o.payment_status)}</span></td>
            <td><strong>${formatCurrency(o.total_amount)}</strong></td>
          </tr>
        `).join('');
      }
    }

    function renderComplaintsTab() {
      if (!clientViewData) return;
      const complaints = clientViewData.complaints || [];
      const tbody = document.getElementById('clientComplaintsTbody');
      if (!complaints.length) {
        tbody.innerHTML = '<tr><td colspan="9">No complaints raised by this client</td></tr>';
      } else {
        tbody.innerHTML = complaints.map((c) => `
          <tr>
            <td>#${c.id}</td>
            <td>${c.order_id ? `#${c.order_id}` : '-'}</td>
            <td>${escapeHtml(c.category)}</td>
            <td>${escapeHtml(c.description || c.subject)}</td>
            <td>${formatDate(c.created_at)}</td>
            <td>${escapeHtml(c.assigned_staff_name || 'Unassigned')}</td>
            <td>${statusBadgeHtml(c.status)}</td>
            <td>${escapeHtml(c.resolution || 'No notes added')}</td>
            <td><button type="button" class="vendor-view-btn" onclick="openClientComplaintResolveModal(${c.id})">Update</button></td>
          </tr>
        `).join('');
      }
    }

    function openClientOrderDetailModal(orderId) {
      if (!clientViewData || !clientViewData.orders) return;
      const order = clientViewData.orders.find((o) => Number(o.id) === Number(orderId));
      if (!order) return;

      document.getElementById('orderDetailModalTitle').textContent = `Order Details: ${order.order_number || `#${order.id}`}`;
      const itemsList = Array.isArray(order.items) && order.items.length ? order.items.map((it) => `
        <div style="display:flex; justify-content:space-between; padding:6px 0; border-bottom:1px solid #f1f5f9;">
          <span><strong>${escapeHtml(it.name || it.product_name || 'Item')}</strong> x ${it.quantity || 1}</span>
          <span>${formatCurrency(it.price || it.unit_price || 0)}</span>
        </div>
      `).join('') : '<p>No items recorded</p>';

      document.getElementById('orderDetailModalBody').innerHTML = `
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:14px; background:#f8fafc; padding:12px; border-radius:10px;">
          <div><strong>Vendor:</strong> ${escapeHtml(order.vendor_name)}</div>
          <div><strong>Payment:</strong> ${escapeHtml(order.payment_method)} (${escapeHtml(order.payment_status)})</div>
          <div><strong>Order Date:</strong> ${formatDate(order.created_at)}</div>
          <div><strong>Status:</strong> ${order.status}</div>
          <div><strong>Delivery Partner:</strong> ${escapeHtml(order.delivery_partner_name)}</div>
          <div><strong>Total Amount:</strong> <span style="font-weight:800; color:#10b981;">${formatCurrency(order.total_amount)}</span></div>
        </div>
        <h4 style="margin:10px 0 6px 0;">Order Items</h4>
        ${itemsList}
      `;
      document.getElementById('clientOrderDetailModal').classList.add('active');
    }

    function closeClientOrderDetailModal() {
      document.getElementById('clientOrderDetailModal').classList.remove('active');
    }

    function openClientComplaintResolveModal(complaintId) {
      if (!clientViewData || !clientViewData.complaints) return;
      const complaint = clientViewData.complaints.find((c) => Number(c.id) === Number(complaintId));
      if (!complaint) return;

      document.getElementById('resolveComplaintId').value = complaint.id;
      document.getElementById('resolveStatus').value = ['Open', 'In Progress', 'Resolved', 'Closed'].includes(complaint.status) ? complaint.status : 'Resolved';
      document.getElementById('resolveNotes').value = complaint.resolution || '';
      document.getElementById('clientComplaintResolveModal').classList.add('active');
    }

    function closeClientComplaintResolveModal() {
      document.getElementById('clientComplaintResolveModal').classList.remove('active');
    }

    async function submitComplaintResolution(event) {
      event.preventDefault();
      const complaintId = document.getElementById('resolveComplaintId').value;
      const status = document.getElementById('resolveStatus').value;
      const resolution = document.getElementById('resolveNotes').value;

      if (!currentViewClientId || !complaintId) return;

      try {
        const response = await fetch(`/clients/${currentViewClientId}/complaints/${complaintId}/resolve`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ status, resolution }),
        });
        const data = await response.json();
        if (!data.success) {
          alert(data.message || 'Unable to update complaint');
          return;
        }
        closeClientComplaintResolveModal();
        // Re-fetch details to update UI automatically
        await openClientViewModal(currentViewClientId);
      } catch (err) {
        console.error('Complaint resolve error:', err);
        alert('Server connection error');
      }
    }
  </script>
</body>
</html>
