<div id="adminTopNotificationContainer" class="admin-top-notif-container" aria-live="polite" aria-atomic="true"></div>

<style>
  .admin-top-notif-container {
    position: fixed;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999999;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    pointer-events: none;
    max-width: 92vw;
    width: 450px;
  }
  
  .admin-top-toast {
    pointer-events: auto;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    border-radius: 14px;
    color: #ffffff;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28), 0 4px 12px rgba(0, 0, 0, 0.15);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    animation: toastSlideDown 0.38s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    transition: opacity 0.3s ease, transform 0.3s ease;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    box-sizing: border-box;
  }

  @keyframes toastSlideDown {
    0% { opacity: 0; transform: translateY(-35px) scale(0.92); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }

  .admin-top-toast.toast-hiding {
    opacity: 0;
    transform: translateY(-25px) scale(0.94);
  }

  /* Color-coded themes by Event Type */
  .toast-vendor {
    background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  }
  .toast-client {
    background: linear-gradient(135deg, #10b981 0%, #047857 100%);
  }
  .toast-delivery {
    background: linear-gradient(135deg, #f59e0b 0%, #b45309 100%);
  }
  .toast-quotation {
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
  }
  .toast-order {
    background: linear-gradient(135deg, #f43f5e 0%, #be123c 100%);
  }
  .toast-wallet {
    background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%);
  }

  .toast-icon-box {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.22);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    flex-shrink: 0;
  }

  .toast-body {
    flex: 1;
    min-width: 0;
  }
  .toast-type-label {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    opacity: 0.9;
    margin-bottom: 2px;
  }
  .toast-title {
    font-size: 14px;
    font-weight: 700;
    margin: 0 0 2px 0;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .toast-message {
    font-size: 12.5px;
    opacity: 0.92;
    margin: 0;
    line-height: 1.3;
    word-break: break-word;
  }

  .toast-close-btn {
    background: rgba(255, 255, 255, 0.2);
    border: none;
    color: white;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 14px;
    font-weight: bold;
    flex-shrink: 0;
    transition: background 0.2s;
  }
  .toast-close-btn:hover {
    background: rgba(255, 255, 255, 0.4);
  }

  /* 5-Second Progress Bar */
  .toast-progress-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 3.5px;
    background: rgba(255, 255, 255, 0.7);
    width: 100%;
    animation: toastProgress 5s linear forwards;
  }

  @keyframes toastProgress {
    0% { width: 100%; }
    100% { width: 0%; }
  }
</style>

<script>
  (function () {
    const container = document.getElementById('adminTopNotificationContainer');
    if (!container) return;

    // Web Audio Synthesizer for 2-Tone Notification Chime Sound
    function playNotificationSound() {
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();

        const osc1 = ctx.createOscillator();
        const gain1 = ctx.createGain();

        osc1.type = 'sine';
        osc1.frequency.setValueAtTime(880, ctx.currentTime); // A5 note
        osc1.frequency.setValueAtTime(1174.66, ctx.currentTime + 0.12); // D6 note

        gain1.gain.setValueAtTime(0.18, ctx.currentTime);
        gain1.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.35);

        osc1.connect(gain1);
        gain1.connect(ctx.destination);

        osc1.start(ctx.currentTime);
        osc1.stop(ctx.currentTime + 0.35);
      } catch (e) {
        // Suppress audio restrictions if user hasn't interacted yet
      }
    }

    // Config for each event type
    const eventConfigMap = {
      new_vendor_register: {
        themeClass: 'toast-vendor',
        icon: '🏪',
        label: 'New Vendor Registered',
      },
      new_client_register: {
        themeClass: 'toast-client',
        icon: '🎉',
        label: 'New Client Registered',
      },
      new_delivery_partner_register: {
        themeClass: 'toast-delivery',
        icon: '🛵',
        label: 'New Delivery Partner Registered',
      },
      new_quotation_raised: {
        themeClass: 'toast-quotation',
        icon: '📑',
        label: 'New Quotation Raised',
      },
      new_order: {
        themeClass: 'toast-order',
        icon: '📦',
        label: 'New Order Placed',
      },
      wallet_activity: {
        themeClass: 'toast-wallet',
        icon: '💳',
        label: 'Wallet Activity',
      },
    };

    const seenEventIds = new Set();

    function showAdminToast(eventData) {
      if (!eventData || !eventData.id) return;
      if (seenEventIds.has(eventData.id)) return;
      seenEventIds.add(eventData.id);

      const cfg = eventConfigMap[eventData.type] || {
        themeClass: 'toast-order',
        icon: '🔔',
        label: 'System Notification',
      };

      const toast = document.createElement('div');
      toast.className = `admin-top-toast ${cfg.themeClass}`;
      toast.onclick = function (e) {
        if (e.target.classList.contains('toast-close-btn')) return;
        if (eventData.link && eventData.link !== '#') {
          window.location.href = eventData.link;
        }
      };

      toast.innerHTML = `
        <div class="toast-icon-box">${cfg.icon}</div>
        <div class="toast-body">
          <div class="toast-type-label">${cfg.label}</div>
          <div class="toast-title">${escapeHtml(eventData.title || cfg.label)}</div>
          <p class="toast-message">${escapeHtml(eventData.message || '')}</p>
        </div>
        <button class="toast-close-btn" title="Dismiss" onclick="this.parentElement.remove()">✕</button>
        <div class="toast-progress-bar"></div>
      `;

      container.appendChild(toast);
      playNotificationSound();

      // Auto dismiss after 5 seconds
      setTimeout(() => {
        toast.classList.add('toast-hiding');
        setTimeout(() => {
          if (toast.parentNode) toast.parentNode.removeChild(toast);
        }, 300);
      }, 5000);
    }

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    // Connect via Real-Time SSE EventSource
    let lastEventTimestamp = Date.now() - 5000;

    function connectAdminSse() {
      try {
        const sse = new EventSource('/api/admin/notifications/stream');

        sse.addEventListener('admin-notification', (e) => {
          try {
            const data = JSON.parse(e.data);
            showAdminToast(data);
          } catch (err) {}
        });

        sse.onerror = function () {
          sse.close();
          // Fallback to Polling every 5 seconds
          startAdminPolling();
        };
      } catch (err) {
        startAdminPolling();
      }
    }

    // Fallback Polling Worker
    let isPollingStarted = false;
    function startAdminPolling() {
      if (isPollingStarted) return;
      isPollingStarted = true;

      setInterval(async () => {
        try {
          const res = await fetch(`/api/admin/notifications/poll?since=${lastEventTimestamp}`);
          const data = await res.json();
          if (data && data.events && data.events.length) {
            data.events.forEach((ev) => {
              if (ev.timestamp > lastEventTimestamp) {
                lastEventTimestamp = ev.timestamp;
              }
              showAdminToast(ev);
            });
          }
        } catch (err) {}
      }, 5000);
    }

    // Initialize Connection
    connectAdminSse();

    // Global helper so any page JS can trigger a notification directly if needed
    window.showAdminNotification = showAdminToast;
  })();
</script>
