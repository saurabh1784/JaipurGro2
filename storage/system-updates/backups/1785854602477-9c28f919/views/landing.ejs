<style>
:root{--g:#176b3a;--mint:#eaf7ef;--ink:#17231c;--muted:#617067;--cream:#fbf9f3;--line:#dce8df}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);background:var(--cream);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.6}a{color:inherit}.wrap{width:min(1120px,calc(100% - 40px));margin:auto}header{position:sticky;top:0;z-index:10;background:#fbf9f3f0;border-bottom:1px solid #176b3a1f;backdrop-filter:blur(12px)}nav{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{display:flex;align-items:center;gap:12px;font-size:1.25rem;font-weight:800;text-decoration:none}.brand img{width:46px;height:46px;border-radius:12px;box-shadow:0 6px 18px #176b3a2e}.links{display:flex;gap:28px;font-size:.93rem;font-weight:700}.links a{text-decoration:none}.hero{padding:82px 0 66px;overflow:hidden}.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:76px;align-items:center}.eyebrow{margin:0 0 18px;color:var(--g);font-size:.8rem;font-weight:800;text-transform:uppercase;letter-spacing:.13em}h1{margin:0;max-width:720px;font-size:clamp(2.8rem,6.2vw,5.5rem);line-height:.98;letter-spacing:-.055em}.lead{max-width:650px;margin:28px 0 34px;color:var(--muted);font-size:1.13rem}.buttons{display:flex;flex-wrap:wrap;gap:13px}.button{display:inline-flex;min-height:50px;align-items:center;padding:0 22px;border-radius:999px;background:var(--g);color:white;font-weight:750;text-decoration:none;box-shadow:0 12px 28px #176b3a33}.button.alt{background:transparent;color:var(--g);border:1px solid var(--g);box-shadow:none}.art{position:relative;min-height:460px;display:grid;place-items:center}.art:before{content:"";position:absolute;width:420px;height:420px;border-radius:50%;background:linear-gradient(145deg,#dff4e6,#f3e7bb)}.art:after{content:"Fresh • Local • Easy";position:absolute;bottom:26px;right:0;padding:13px 20px;border-radius:15px;background:white;color:var(--g);font-size:.86rem;font-weight:800;box-shadow:0 18px 45px #23372b21}.art img{position:relative;width:min(310px,70vw);border-radius:28%;box-shadow:0 30px 70px #1743283d;transform:rotate(-3deg)}section{padding:82px 0}.head{max-width:720px;margin-bottom:40px}h2{margin:0 0 12px;font-size:clamp(2rem,4vw,3.25rem);line-height:1.08;letter-spacing:-.04em}.head p,.card p,.about p{color:var(--muted)}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{padding:28px;border:1px solid var(--line);border-radius:22px;background:#ffffffb8}.icon{width:46px;height:46px;margin-bottom:20px;display:grid;place-items:center;border-radius:14px;background:var(--mint);color:var(--g);font-size:1.3rem}.card h3{margin:0 0 8px;font-size:1.12rem}.card p{margin:0;font-size:.95rem}.data{background:var(--g);color:white}.data-grid{display:grid;grid-template-columns:.86fr 1.14fr;gap:70px}.data .eyebrow{color:#bce8cb}.data-copy p{color:#d9eee0}.data-list{display:grid;gap:12px}.data-item{padding:18px 20px;border:1px solid #ffffff2e;border-radius:16px;background:#ffffff14}.data-item strong{display:block;margin-bottom:3px}.data-item span{color:#d9eee0;font-size:.91rem}.policy{margin-top:26px;padding-top:22px;border-top:1px solid #ffffff33}.policy a{font-weight:800;text-underline-offset:4px}.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px}.fact{padding:20px 0;border-bottom:1px solid var(--line)}.fact strong{display:block;color:var(--g)}footer{padding:42px 0;color:#d6e7dc;background:#102b1d;font-size:.9rem}.foot{display:flex;justify-content:space-between;gap:30px}.foot strong{color:white;font-size:1.08rem}.footlinks{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:20px}.footlinks a{color:white;text-underline-offset:4px}@media(max-width:820px){.hero-grid,.data-grid,.about-grid{grid-template-columns:1fr;gap:42px}.hero{padding-top:58px}.art{min-height:360px}.art:before{width:330px;height:330px}.cards{grid-template-columns:1fr}}@media(max-width:620px){.wrap{width:min(100% - 28px,1120px)}.links a