  <script>
    const $ = x => document.getElementById(x);
    const vals = f => Object.fromEntries(new FormData(f));

    // Tab Switcher
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
        
        btn.classList.add('active');
        const target = btn.dataset.tab;
        $(target).classList.add('active');
        window.location.hash = target.replace('tab-', '');
      });
    });

    if (window.location.hash) {
      const hash = window.location.hash.replace('#', '');
      const matchedBtn = document.querySelector(`.tab-btn[data-tab="tab-${hash}"]`);
      if (matchedBtn) matchedBtn.click();
    }

    // Instant WhatsApp Switch Handler
    const whatsappSwitch = $('whatsappToggleSwitch');
    if (whatsappSwitch) {
      whatsappSwitch.addEventListener('change', async () => {
        const isChecked = whatsappSwitch.checked;
        try {
          let res = await api('/api/message-settings/whatsapp-toggle', 'POST', { enabled: isChecked });
          updateWhatsappUI(res.whatsappEnabled);
          toast(res.message);
        } catch(err) {
          whatsappSwitch.checked = !isChecked; // revert on error
          toast(err.message || 'Failed to update WhatsApp setting.');
        }
      });
    }

    function updateWhatsappUI(enabled) {
      const badge = $('whatsappBadge');
      const heroStatus = $('heroWhatsappStatus');
      const hiddenInput = $('hiddenWhatsappEnabled');
      if (badge) {
        badge.className = 'badge ' + (enabled ? 'badge-success' : 'badge-danger');
        badge.textContent = enabled ? 'ENABLED' : 'DISABLED';
      }
      if (heroStatus) heroStatus.textContent = enabled ? 'ON' : 'OFF';
      if (hiddenInput) hiddenInput.value = enabled ? 'true' : 'false';
      if (whatsappSwitch) whatsappSwitch.checked = enabled;
    }

    // Copy Webhook Link
    $("copyWebhook").addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText($("webhookUrl").value);
        toast("Webhook URL copied to clipboard");
      } catch(e) {
        $("webhookUrl").select();
        document.execCommand("copy");
        toast("Webhook URL copied to clipboard");
      }
    });

    function result(id, ok, msg, data) {
      let e = $(id);
      e.className = 'result ' + (ok ? 'ok' : 'bad');
      e.textContent = msg + (data ? '\n\n' + JSON.stringify(data, null, 2) : '');
    }

    function toast(m) {
      let e = $('toast');
      e.textContent = m;
      e.style.display = 'block';
      setTimeout(() => e.style.display = 'none', 4500);
    }

    async function api(u, m, b) {
      let r = await fetch(u, {
        method: m,
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(b)
      });
      let d = await r.json().catch(() => ({ message: 'Unexpected server response.' }));
      if (!r.ok || d.success === false) throw Error(d.message || 'Request failed.');
      return d;
    }

    // Copy Key Handlers
    document.querySelectorAll('.copy-key-btn').forEach(button => button.addEventListener('click', async () => {
      const input = $(button.dataset.target);
      if (input && input.value) {
        try {
          await navigator.clipboard.writeText(input.value);
          toast("Key copied to clipboard");
        } catch(e) {
          input.select();
          document.execCommand("copy");
          toast("Key copied to clipboard");
        }
      }
    }));

    // Secret Toggles (for Password fields)
    document.querySelectorAll('.secret-toggle').forEach(button => button.addEventListener('click', () => {
      const input = $(button.dataset.target);
      input.type = input.type === 'password' ? 'text' : 'password';
      button.textContent = input.type === 'password' ? 'View' : 'Hide';
    }));

    // MSG91 Settings Form
    let s = $('settings');
    if (s) {
      s.addEventListener('submit', async e => {
        e.preventDefault();
        let b = vals(s);
        b.enabled = s.elements.enabled.checked;
        b.whatsappEnabled = whatsappSwitch ? whatsappSwitch.checked : true;
        try {
          let d = await api('/api/message-settings/msg91', 'PUT', b);
          result('settingsResult', 1, d.message);
          toast(d.message);
          if (d.config && typeof d.config.whatsappEnabled !== 'undefined') updateWhatsappUI(d.config.whatsappEnabled);
          if (d.config && d.config.authKey) s.elements.authKey.value = d.config.authKey;
          if (d.config && d.config.widgetToken) s.elements.widgetToken.value = d.config.widgetToken;
        } catch(x) {
          result('settingsResult', 0, x.message);
        }
      });
    }

    // Email Form
    let emailForm = $('emailSettingsForm');
    if (emailForm) {
      emailForm.addEventListener('submit', async e => {
        e.preventDefault();
        const payload = {
          mailDriver: emailForm.elements.mailDriver.value,
          host: emailForm.elements.host.value,
          port: emailForm.elements.port.value,
          encryption: emailForm.elements.encryption.value,
          username: emailForm.elements.username.value,
          password: emailForm.elements.password.value,
          fromEmail: emailForm.elements.fromEmail.value,
          fromName: emailForm.elements.fromName.value,
          status: emailForm.elements.status.value,
          triggers: {
            userWelcome: emailForm.elements.triggerUserWelcome.checked,
            userOrderInvoice: emailForm.elements.triggerUserOrderInvoice.checked,
            userDeliveryStatus: emailForm.elements.triggerUserDeliveryStatus.checked,
            userPasswordReset: emailForm.elements.triggerUserPasswordReset.checked,
            vendorNewOrder: emailForm.elements.triggerVendorNewOrder.checked,
            deliveryAssignment: emailForm.elements.triggerDeliveryAssignment.checked,
          }
        };

        try {
          let d = await api('/api/message-settings/email', 'PUT', payload);
          result('emailSettingsResult', 1, d.message || 'Email settings saved successfully');
          toast(d.message || 'Email settings saved successfully');
        } catch (x) {
          result('emailSettingsResult', 0, x.message);
        }
      });
    }

    // Test Email
    let testEmailForm = $('testEmailForm');
    if (testEmailForm) {
      testEmailForm.addEventListener('submit', async e => {
        e.preventDefault();
        try {
          let d = await api('/api/message-settings/test-email', 'POST', vals(e.target));
          result('testEmailResult', 1, d.message || 'Test email sent successfully!', d);
          toast('Test email sent successfully');
        } catch (x) {
          result('testEmailResult', 0, x.message);
        }
      });
    }

    // Test OTP & Messages
    $('otpSend').addEventListener('submit', async e => {
      e.preventDefault();
      try {
        let d = await api('/api/message-settings/test-otp/send', 'POST', vals(e.target));
        if (d.reqId) $('reqId').value = d.reqId;
        result('otpResult', 1, d.message, d);
        toast(d.message);
      } catch(x) {
        result('otpResult', 0, x.message);
      }
    });

    $('otpVerify').addEventListener('submit', async e => {
      e.preventDefault();
      try {
        let d = await api('/api/message-settings/test-otp/verify', 'POST', vals(e.target));
        result('otpResult', 1, d.message, d);
        toast(d.message);
      } catch(x) {
        result('otpResult', 0, x.message);
      }
    });

    $('testMessage').addEventListener('submit', async e => {
      e.preventDefault();
      try {
        let d = await api('/api/message-settings/test-message', 'POST', vals(e.target));
        result('messageResult', 1, d.message, d.providerResponse);
        toast(d.message);
      } catch(x) {
        result('messageResult', 0, x.message);
      }
    });

    // ===============================================
    // IN-APP MESSAGE TEMPLATE SYSTEM JS
    // ===============================================
    const allInAppTemplates = <%- JSON.stringify(inAppTemplates || []) %>;
    let focusedInAppField = 'inAppContent';

    const titleField = $('inAppTitle');
    const contentField = $('inAppContent');
    if (titleField) titleField.addEventListener('focus', () => focusedInAppField = 'inAppTitle');
    if (contentField) contentField.addEventListener('focus', () => focusedInAppField = 'inAppContent');

    function filterInAppCards() {
      const appFilter = $('filterInAppApp').value;
      const eventFilter = $('filterInAppEvent').value;
      const cards = document.querySelectorAll('.inapp-card');

      cards.forEach(card => {
        const app = card.dataset.app;
        const evt = card.dataset.event;
        const matchApp = (appFilter === 'all' || app === 'all' || app === appFilter);
        const matchEvt = (eventFilter === 'all' || evt === eventFilter);
        card.style.display = (matchApp && matchEvt) ? 'flex' : 'none';
      });
    }

    function openInAppModal() {
      $('inAppModalTitle').textContent = 'Create In-App Message Template';
      $('inAppId').value = '';
      $('inAppName').value = '';
      $('inAppKey').value = '';
      $('inAppTargetApp').value = 'client';
      $('inAppEventType').value = 'registration';
      $('inAppTitle').value = '';
      $('inAppContent').value = '';
      $('inAppStatus').checked = true;
      $('inAppModalBackdrop').style.display = 'flex';
    }

    function editInAppTemplateById(id) {
      const tpl = allInAppTemplates.find(t => String(t.id) === String(id));
      if (!tpl) return toast('Template not found');
      $('inAppModalTitle').textContent = 'Edit In-App Message Template';
      $('inAppId').value = tpl.id;
      $('inAppName').value = tpl.name || '';
      $('inAppKey').value = tpl.template_key || '';
      $('inAppTargetApp').value = tpl.target_app || 'client';
      $('inAppEventType').value = tpl.event_type || 'order_update';
      $('inAppTitle').value = tpl.title || '';
      $('inAppContent').value = tpl.content || '';
      $('inAppStatus').checked = tpl.status === 'active';
      $('inAppModalBackdrop').style.display = 'flex';
    }

    function closeInAppModal() {
      $('inAppModalBackdrop').style.display = 'none';
    }

    function insertInAppVar(varName) {
      const targetInput = $(focusedInAppField) || $('inAppContent');
      const textToInsert = `{{${varName}}}`;
      const start = targetInput.selectionStart || targetInput.value.length;
      const end = targetInput.selectionEnd || targetInput.value.length;
      targetInput.value = targetInput.value.substring(0, start) + textToInsert + targetInput.value.substring(end);
      targetInput.focus();
      targetInput.setSelectionRange(start + textToInsert.length, start + textToInsert.length);
    }

    async function saveInAppTemplate() {
      const id = $('inAppId').value;
      const payload = {
        id: id || undefined,
        name: $('inAppName').value.trim(),
        template_key: $('inAppKey').value.trim(),
        target_app: $('inAppTargetApp').value,
        event_type: $('inAppEventType').value,
        title: $('inAppTitle').value.trim(),
        content: $('inAppContent').value.trim(),
        status: $('inAppStatus').checked ? 'active' : 'inactive',
      };

      try {
        const res = await api('/api/inapp-templates', 'POST', payload);
        toast(res.message || 'In-App Template saved successfully!');
        closeInAppModal();
        setTimeout(() => window.location.reload(), 800);
      } catch (err) {
        toast(err.message || 'Failed to save In-App Template');
      }
    }

    async function toggleInAppTemplate(id, checkboxElem) {
      const isChecked = checkboxElem.checked;
      try {
        const res = await api(`/api/inapp-templates/${id}/toggle`, 'POST', { status: isChecked ? 'active' : 'inactive' });
        toast(res.message);
      } catch (err) {
        checkboxElem.checked = !isChecked;
        toast(err.message || 'Failed to toggle status');
      }
    }

    async function deleteInAppTemplate(id) {
      if (!confirm('Are you sure you want to delete this in-app message template?')) return;
      try {
        const res = await api(`/api/inapp-templates/${id}`, 'DELETE');
        toast(res.message);
        setTimeout(() => window.location.reload(), 800);
      } catch (err) {
        toast(err.message || 'Failed to delete template');
      }
    }

    async function previewInAppModal(id) {
      const tpl = allInAppTemplates.find(t => String(t.id) === String(id));
      if (!tpl) return toast('Template not found');
      try {
        const res = await api('/api/inapp-templates/preview', 'POST', {
          title: tpl.title,
          content: tpl.content,
        });
        $('previewAppBadge').textContent = tpl.target_app === 'client' ? 'Customer App' : (tpl.target_app === 'vendor' ? 'Vendor App' : (tpl.target_app === 'delivery' ? 'Delivery App' : 'Groxen App'));
        $('previewTitleText').textContent = res.title;
        $('previewContentText').textContent = res.content;
        $('inAppPreviewModalBackdrop').style.display = 'flex';
      } catch (err) {
        toast(err.message || 'Failed to generate preview');
      }
    }

    async function previewModalForm() {
      try {
        const res = await api('/api/inapp-templates/preview', 'POST', {
          title: $('inAppTitle').value,
          content: $('inAppContent').value,
        });
        $('previewAppBadge').textContent = $('inAppTargetApp').options[$('inAppTargetApp').selectedIndex].text;
        $('previewTitleText').textContent = res.title;
        $('previewContentText').textContent = res.content;
        $('inAppPreviewModalBackdrop').style.display = 'flex';
      } catch (err) {
        toast(err.message || 'Failed to generate preview');
      }
    }

    function closeInAppPreviewModal() {
      $('inAppPreviewModalBackdrop').style.display = 'none';
    }

    // ===============================================
    // EMAIL TEMPLATE SYSTEM JS
    // ===============================================
    const allEmailTemplates = <%- JSON.stringify(emailTemplates || []) %>;
    let focusedEmailField = 'emailContent';

    const emailSubjectEl = $('emailSubject');
    const emailContentEl = $('emailContent');
    if (emailSubjectEl) emailSubjectEl.addEventListener('focus', () => focusedEmailField = 'emailSubject');
    if (emailContentEl) emailContentEl.addEventListener('focus', () => focusedEmailField = 'emailContent');

    function openEmailModal() {
      $('emailModalTitle').textContent = 'Create Email Template';
      $('emailId').value = '';
      $('emailName').value = '';
      $('emailKey').value = '';
      $('emailSubject').value = '';
      $('emailContent').value = '';
      $('emailStatus').checked = true;
      $('emailModalBackdrop').style.display = 'flex';
    }

    function editEmailTemplateById(id) {
      const tpl = allEmailTemplates.find(t => String(t.id) === String(id));
      if (!tpl) return toast('Template not found');
      $('emailModalTitle').textContent = 'Edit Email Template';
      $('emailId').value = tpl.id;
      $('emailName').value = tpl.name || '';
      $('emailKey').value = tpl.template_key || '';
      $('emailSubject').value = tpl.subject || '';
      $('emailContent').value = tpl.content || '';
      $('emailStatus').checked = tpl.status === 'active';
      $('emailModalBackdrop').style.display = 'flex';
    }

    function closeEmailModal() {
      $('emailModalBackdrop').style.display = 'none';
    }

    function insertEmailVar(varName) {
      const targetInput = $(focusedEmailField) || $('emailContent');
      const textToInsert = `{{${varName}}}`;
      const start = targetInput.selectionStart || targetInput.value.length;
      const end = targetInput.selectionEnd || targetInput.value.length;
      targetInput.value = targetInput.value.substring(0, start) + textToInsert + targetInput.value.substring(end);
      targetInput.focus();
      targetInput.setSelectionRange(start + textToInsert.length, start + textToInsert.length);
    }

    async function saveEmailTemplate() {
      const id = $('emailId').value;
      const payload = {
        id: id || undefined,
        channel: 'email',
        template_key: $('emailKey').value.trim(),
        name: $('emailName').value.trim(),
        subject: $('emailSubject').value.trim(),
        content: $('emailContent').value.trim(),
        status: $('emailStatus').checked ? 'active' : 'inactive',
      };

      try {
        const res = await api('/message-settings/templates', 'POST', payload);
        toast(res.message || 'Email Template saved successfully!');
        closeEmailModal();
        setTimeout(() => window.location.reload(), 800);
      } catch (err) {
        toast(err.message || 'Failed to save Email Template');
      }
    }

    async function toggleEmailTemplate(id, checkboxElem) {
      const isChecked = checkboxElem.checked;
      try {
        const res = await api(`/message-settings/templates/${id}/toggle`, 'POST', { status: isChecked ? 'active' : 'inactive' });
        toast(res.message);
      } catch (err) {
        checkboxElem.checked = !isChecked;
        toast(err.message || 'Failed to toggle status');
      }
    }

    async function deleteEmailTemplate(id) {
      if (!confirm('Are you sure you want to delete this email template?')) return;
      try {
        const res = await api(`/message-settings/templates/${id}/delete`, 'POST');
        toast(res.message);
        setTimeout(() => window.location.reload(), 800);
      } catch (err) {
        toast(err.message || 'Failed to delete email template');
      }
    }

    async function previewEmailModal(id) {
      const tpl = allEmailTemplates.find(t => String(t.id) === String(id));
      if (!tpl) return toast('Template not found');
      try {
        const res = await api('/message-settings/templates/preview', 'POST', {
          channel: 'email',
          templateKey: tpl.template_key
        });
        $('emailPreviewSubject').textContent = res.rendered.subject || tpl.subject;
        $('emailPreviewFrame').innerHTML = res.rendered.content || tpl.content;
        $('emailPreviewModalBackdrop').style.display = 'flex';
      } catch (err) {
        toast(err.message || 'Failed to generate preview');
      }
    }

    async function previewEmailModalForm() {
      try {
        const sample = {
          userName: 'Rahul Sharma',
          userEmail: 'rahul@example.com',
          orderId: '1094',
          orderDate: '29/07/2026',
          itemsTotal: '450.00',
          deliveryFee: '40.00',
          totalAmount: '490.00',
          deliveryAddress: 'Flat 402, Sunshine Heights, Malviya Nagar, Jaipur',
          deliveryStatus: 'Out for Delivery',
          otpCode: '5829',
          riderName: 'Vikram Singh',
          riderPhone: '+91 9876543210',
          storeName: 'GROXEN',
          supportEmail: 'support@groxen.in'
        };
        let subj = $('emailSubject').value;
        let body = $('emailContent').value;
        for (let k in sample) {
          const reg = new RegExp('\\{\\{\\s*' + k + '\\s*\\}\\}', 'g');
          subj = subj.replace(reg, sample[k]);
          body = body.replace(reg, sample[k]);
        }
        $('emailPreviewSubject').textContent = subj;
        $('emailPreviewFrame').innerHTML = body;
        $('emailPreviewModalBackdrop').style.display = 'flex';
      } catch (err) {
        toast(err.message || 'Failed to generate preview');
      }
    }

    function closeEmailPreviewModal() {
      $('emailPreviewModalBackdrop').style.display = 'none';
    }
  </script>
</body>
</html>
