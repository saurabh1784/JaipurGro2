<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= shell.roleTitle %> - Product Catalog</title>
  <link rel="stylesheet" href="/styles.css" />
  <script src="/product-image-fallback.js"></script>
</head>
<body class="system-theme">
  <%- include('partials/system_sidebar', { shell }) %>

  <main class="system-main">
    <header class="topbar">
      <div>
        <p class="crumb">Dashboard / Products</p>
        <h1>Product Catalog</h1>
      </div>
      <div class="topbar-actions">
        <button class="icon-button" type="button" aria-label="Cart" onclick="openCart()">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14v16H5z"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
          <span id="cart-count" class="cart-count-badge">0</span>
        </button>
      </div>
    </header>

    <section class="promo-scroll-shell" id="promoScrollShell" hidden>
      <div class="promo-scroll-track" id="promoScrollTrack"></div>
    </section>

    <section class="cart-section" id="cart-section" style="display: none;">
      <div class="cart-panel">
        <div class="cart-header">
          <h2>Your Cart</h2>
          <button type="button" onclick="closeCart()" class="cart-close">&times;</button>
        </div>
        <div id="cart-items" class="cart-items">
          <p class="cart-empty">Your cart is empty</p>
        </div>
        <div class="cart-summary" id="cart-summary" style="display: none;">
          <label class="cart-coupon-field">
            Coupon Code
            <input id="cart-coupon-code" type="text" placeholder="Optional coupon" />
          </label>
          <div class="cart-total">
            <span>Total:</span>
            <strong id="cart-total-amount">₹0.00</strong>
          </div>
          <div class="checkout-options">
            <button class="btn-checkout" onclick="directOrder()">Direct Order</button>
            <button class="btn-quotation" onclick="sendQuotation()">Send Quotation</button>
          </div>
        </div>
      </div>
    </section>

    <section class="payment-section" id="payment-section" style="display: none;">
      <div class="payment-panel">
        <div class="cart-header">
          <h2>Payment Summary</h2>
          <button type="button" onclick="closePaymentPage()" class="cart-close">&times;</button>
        </div>
        <div id="payment-summary" class="payment-summary">
          <p class="cart-empty">Calculating payment details...</p>
        </div>
        <div class="checkout-options">
          <button class="btn-checkout" id="confirm-payment-button" type="button" onclick="confirmDirectOrder()">Pay & Place Order</button>
          <button class="btn-quotation" type="button" onclick="closePaymentPage()">Back to Cart</button>
        </div>
      </div>
    </section>

    <!-- Variation Selection Side Card Drawer -->
    <section class="variation-side-section" id="variation-side-section" style="display: none;">
      <div class="variation-side-backdrop" onclick="closeVariationSideCard()"></div>
      <div class="variation-side-panel">
        <div class="variation-side-header">
          <div class="variation-side-title-group">
            <span class="variation-badge">Select Variation</span>
            <h2 id="var-side-product-name">Product Name</h2>
            <p id="var-side-product-category" class="var-side-subtext">Category Name</p>
          </div>
          <button type="button" onclick="closeVariationSideCard()" class="cart-close" aria-label="Close variation panel">&times;</button>
        </div>

        <div class="variation-side-body">
          <div class="variation-product-preview">
            <img id="var-side-product-img" src="/default.png" alt="Product" />
            <div class="var-preview-info">
              <span id="var-side-price-range" class="var-price-range">₹0.00</span>
              <p id="var-side-desc" class="var-desc-text">Choose your preferred weight / package option below.</p>
            </div>
          </div>

          <h3 class="variation-cards-heading">Available Options</h3>
          <div id="variation-cards-container" class="variation-cards-list">
            <!-- Dynamically populated variation cards -->
          </div>

          <div class="variation-quantity-row">
            <span>Quantity:</span>
            <div class="var-qty-controls">
              <button type="button" onclick="changeVariationQty(-1)" class="var-qty-btn">-</button>
              <input type="number" id="var-selected-qty" value="1" min="1" readonly class="var-qty-input" />
              <button type="button" onclick="changeVariationQty(1)" class="var-qty-btn">+</button>
            </div>
          </div>
        </div>

        <div class="variation-side-footer">
          <button type="button" id="btn-add-variation-cart" class="btn-add-var-cart" onclick="addSelectedVariationToCart()">
            Add Selected Variation to Cart
          </button>
        </div>
      </div>
    </section>

    <section class="products-section">
      <div class="client-category-page">
        <div>
          <p class="category-eyebrow">Shop by main category</p>
          <h2>Main Categories</h2>
        </div>
        <div class="client-category-grid" id="client-category-grid"></div>
      </div>

      <div class="products-header">
        <h2>Available Products</h2>
        <div class="client-filter-bar">
          <select id="category-filter" aria-label="Category filter">
            <option value="">Select Main Category</option>
            <% categories.forEach(function(category) { %>
              <option value="<%= category.id %>"><%= category.name %></option>
            <% }); %>
          </select>
          <select id="subcategory-filter" aria-label="Subcategory filter">
            <option value="">All Subcategories</option>
          </select>
          <select id="brand-filter" aria-label="Brand filter">
            <option value="">All Brands</option>
          </select>
          <div class="search-box-container">
            <input type="search" id="search-input" placeholder="Search products..." />
            <div class="suggestions-panel" id="suggestions-panel" hidden></div>
          </div>
        </div>
      </div>

      <div class="products-grid" id="products-grid">
        <% products.forEach(function(product) { %>
          <div class="product-card" data-product-id="<%= product.id %>" data-master-product-id="<%= product.product_id %>" data-product-name="<%= product.product_name.toLowerCase() %>" data-product-description="<%= (product.description || '').toLowerCase() %>">
            <div class="product-media">
              <img class="product-thumb-image" data-product-placeholder data-product-name="<%= product.product_name %>" src="<%= product.image_url || '/default.png' %>" alt="<%= product.product_name %>" loading="lazy" />
            </div>
            <div class="product-info">
              <div class="product-title-row">
                <h3 class="product-name"><%= product.product_name %></h3>
                <span class="stock-badge <%= product.quantity > 10 ? 'in-stock' : product.quantity > 0 ? 'low-stock' : 'out-stock' %>">
                  <%= product.quantity > 0 ? product.quantity + ' left' : 'Out' %>
                </span>
              </div>
              <% if (product.description) { %>
                <p class="product-description"><%= product.description %></p>
              <% } %>
              <div class="product-meta">
                <span class="product-category"><%= product.category_name %></span>
                <span class="product-brand"><%= product.brand_name %></span>
                <span class="product-weight"><%= product.weight_label || ((product.weight_value || product.weight_kg || 0) + ' ' + (product.weight_unit || 'kg')) %></span>
              </div>
              <div class="product-price">
                <span>Unit price</span>
                <strong>INR <%= product.visible_price.toFixed(2) %></strong>
              </div>
            </div>
            <div class="product-actions">
              <div class="quantity-selector">
                <button type="button" class="qty-btn" onclick="decreaseQty(this)" aria-label="Decrease quantity" <%= product.quantity <= 0 ? 'disabled' : '' %>>-</button>
                <input type="number" class="qty-input" value="1" min="1" max="<%= product.quantity %>" <%= product.quantity <= 0 ? 'disabled' : '' %> />
                <button type="button" class="qty-btn" onclick="increaseQty(this)" aria-label="Increase quantity" <%= product.quantity <= 0 ? 'disabled' : '' %>>+</button>
              </div>
              <button
                type="button"
                class="btn-add-cart"
                data-id="<%= product.id %>"
                data-vendor-product-id="<%= product.id %>"
                data-master-product-id="<%= product.product_id %>"
                data-name="<%= product.product_name %>"
                data-price="<%= product.visible_price %>"
                data-category-id="<%= product.category_id %>"
                data-category-name="<%= product.category_name %>"
                data-weight-label="<%= product.weight_label || ((product.weight_value || product.weight_kg || 0) + ' ' + (product.weight_unit || 'kg')) %>"
                data-weight-kg="<%= product.weight_kg || 0 %>"
                data-max-qty="<%= product.quantity %>"
                onclick="addToCartFromButton(this)"
                <%= product.quantity <= 0 ? 'disabled' : '' %>>
                Add to Cart
              </button>
            </div>
          </div>
        <% }); %>
      </div>
    </section>
  </main>

  <script>
    const clientUserId = '<%= user.id %>';
    const lastCategoryStorageKey = `jaipurgro.client.${clientUserId}.lastCategory`;
    let cart = JSON.parse(localStorage.getItem('clientCart') || '[]');
    let pendingPaymentPreview = null;
    const catalog = {
      categories: <%- JSON.stringify(categories || []) %>,
      subcategories: <%- JSON.stringify(subcategories || []) %>,
      brands: <%- JSON.stringify(brands || []) %>,
    };
    const categoryGrid = document.getElementById('client-category-grid');
    const productsGrid = document.getElementById('products-grid');
    const categoryFilter = document.getElementById('category-filter');
    const subcategoryFilter = document.getElementById('subcategory-filter');
    const brandFilter = document.getElementById('brand-filter');
    const searchInput = document.getElementById('search-input');
    const suggestionsPanel = document.getElementById('suggestions-panel');

    function saveCart() {
      localStorage.setItem('clientCart', JSON.stringify(cart));
    }

    function escapeHtml(value) {
      return String(value || '').replace(/[&<>"']/g, (char) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;',
      }[char]));
    }

    function debounce(fn, delay) {
      let timer;
      return (...args) => {
        clearTimeout(timer);
        timer = setTimeout(() => fn(...args), delay);
      };
    }

    function optionList(items, emptyLabel) {
      return `<option value="">${emptyLabel}</option>` + items
        .slice()
        .sort((a, b) => String(a.name || '').localeCompare(String(b.name || '')))
        .map((item) => `<option value="${item.id}">${escapeHtml(item.name)}</option>`)
        .join('');
    }

    function subcategoryKey(item) {
      return item.sub_category_id || item.subcategory_id;
    }

    function uniqueBrands(items) {
      const seen = new Set();
      return items.filter((item) => {
        const key = String(item.name || '').trim().toLowerCase();
        if (seen.has(key)) return false;
        seen.add(key);
        return true;
      });
    }

    function brandOptionList(items) {
      return '<option value="">All Brands</option>' + items
        .slice()
        .sort((a, b) => String(a.name || '').localeCompare(String(b.name || '')))
        .map((item) => `<option value="${escapeHtml(item.name)}">${escapeHtml(item.name)}</option>`)
        .join('');
    }

    function updateSubcategoryFilter() {
      const categoryId = categoryFilter.value;
      const items = categoryId
        ? catalog.subcategories.filter((item) => String(item.category_id) === String(categoryId))
        : catalog.subcategories;
      subcategoryFilter.innerHTML = optionList(items, 'All Subcategories');
    }

    function renderCategoryGrid() {
      const items = (catalog.categories || []).filter((category) => category.status === 'active');
      categoryGrid.innerHTML = items.length
        ? items.map((category) => `
          <button type="button" class="client-category-card ${String(categoryFilter.value) === String(category.id) ? 'active' : ''}" onclick="selectCategory(${category.id})">
            <span>${escapeHtml(category.name).slice(0, 1).toUpperCase()}</span>
            <strong>${escapeHtml(category.name)}</strong>
          </button>
        `).join('')
        : '<p class="cart-empty">No categories available</p>';
    }

    function selectCategory(categoryId) {
      categoryFilter.value = String(categoryId);
      saveSelectedCategory();
      updateSubcategoryFilter();
      subcategoryFilter.value = '';
      updateBrandFilter();
      renderCategoryGrid();
      loadProducts();
    }

    function saveSelectedCategory() {
      if (categoryFilter.value) {
        localStorage.setItem(lastCategoryStorageKey, categoryFilter.value);
      } else {
        localStorage.removeItem(lastCategoryStorageKey);
      }
    }

    function restoreSelectedCategory() {
      const saved = localStorage.getItem(lastCategoryStorageKey);
      if (!saved) return;
      const exists = [...categoryFilter.options].some((option) => option.value === saved);
      if (exists) {
        categoryFilter.value = saved;
      } else {
        localStorage.removeItem(lastCategoryStorageKey);
      }
    }

    async function refreshCatalog() {
      try {
        const response = await fetch('/api/client/categories', { headers: { Accept: 'application/json' } });
        const data = await response.json();
        if (!data.success) return;
        const selected = categoryFilter.value;
        catalog.categories = data.categories || [];
        categoryFilter.innerHTML = optionList(catalog.categories.filter((category) => category.status === 'active'), 'Select Main Category');
        if (selected && catalog.categories.some((category) => String(category.id) === String(selected))) {
          categoryFilter.value = selected;
          saveSelectedCategory();
        } else if (selected) {
          localStorage.removeItem(lastCategoryStorageKey);
        }
        updateSubcategoryFilter();
        updateBrandFilter();
        renderCategoryGrid();
      } catch (_) {}
    }

    function updateBrandFilter() {
      const categoryId = categoryFilter.value;
      const subcategoryId = subcategoryFilter.value;
      const items = uniqueBrands(catalog.brands
        .filter((item) => !categoryId || String(item.category_id) === String(categoryId))
        .filter((item) => !subcategoryId || String(subcategoryKey(item)) === String(subcategoryId)));
      brandFilter.innerHTML = brandOptionList(items);
    }

    let allLoadedProductsMap = {};
    let currentSelectedProduct = null;
    let currentSelectedVariant = null;
    let currentSelectedVariantQty = 1;

    function productCard(product) {
      const stockClass = product.quantity > 10 ? 'in-stock' : product.quantity > 0 ? 'low-stock' : 'out-stock';
      const stockText = product.quantity > 0 ? `${product.quantity} in stock` : 'Out of stock';
      const disabled = product.quantity <= 0 ? 'disabled' : '';
      const weight = product.weight_label || `${Number(product.weight_value ?? product.weight_kg ?? 0)} ${product.weight_unit || 'kg'}`;
      const hasVariants = product.variants && product.variants.length > 0;
      const variantBadge = hasVariants ? `<span class="var-count-pill" onclick="handleProductAddToCart(this)" data-id="${product.id}">✨ ${product.variants.length} Options</span>` : '';
      const buttonLabel = hasVariants ? `Select Option (${product.variants.length})` : 'Add to Cart';

      return `
        <div class="product-card" data-product-id="${product.id}" data-master-product-id="${product.product_id}" data-product-name="${escapeHtml(product.product_name || '').toLowerCase()}" data-product-description="${escapeHtml(product.description || '').toLowerCase()}">
          <div class="product-media">
            <img class="product-thumb-image" data-product-placeholder data-product-name="${escapeHtml(product.product_name)}" src="${escapeHtml(product.image_url || '/default.png')}" alt="${escapeHtml(product.product_name)}" loading="lazy" />
          </div>
          <div class="product-info">
            <div class="product-title-row">
              <h3 class="product-name">${escapeHtml(product.product_name)}</h3>
              <span class="stock-badge ${stockClass}">${stockText}</span>
            </div>
            ${product.description ? `<p class="product-description">${escapeHtml(product.description)}</p>` : ''}
            <div class="product-meta">
              <span class="product-category">${escapeHtml(product.category_name)}</span>
              <span class="product-brand">${escapeHtml(product.brand_name)}</span>
              <span class="product-weight">${escapeHtml(weight)}</span>
              ${variantBadge}
            </div>
            <div class="product-price"><span>Unit price</span><strong>INR ${Number(product.visible_price || 0).toFixed(2)}</strong></div>
          </div>
          <div class="product-actions">
            <div class="quantity-selector">
              <button type="button" class="qty-btn" onclick="decreaseQty(this)" aria-label="Decrease quantity" ${disabled}>-</button>
              <input type="number" class="qty-input" value="1" min="1" max="${product.quantity}" ${disabled} />
              <button type="button" class="qty-btn" onclick="increaseQty(this)" aria-label="Increase quantity" ${disabled}>+</button>
            </div>
            <button type="button" class="btn-add-cart ${hasVariants ? 'btn-has-variants' : ''}"
              data-id="${product.id}"
              data-vendor-product-id="${product.id}"
              data-master-product-id="${product.product_id}"
              data-name="${escapeHtml(product.product_name)}"
              data-price="${Number(product.visible_price || 0)}"
              data-category-id="${product.category_id || ''}"
              data-category-name="${escapeHtml(product.category_name || '')}"
              data-weight-label="${escapeHtml(weight)}"
              data-weight-kg="${Number(product.weight_kg || 0)}"
              data-max-qty="${product.quantity}"
              onclick="handleProductAddToCart(this)"
              ${disabled}>${buttonLabel}</button>
          </div>
        </div>`;
    }

    async function loadProducts() {
      if (!categoryFilter.value) {
        productsGrid.innerHTML = '<div class="category-first-empty">Select a main category first, then choose products for quotation.</div>';
        return;
      }
      const params = new URLSearchParams();
      if (categoryFilter.value) params.set('category_id', categoryFilter.value);
      if (subcategoryFilter.value) params.set('sub_category_id', subcategoryFilter.value);
      if (brandFilter.value) params.set('brand_name', brandFilter.value);
      const searchTerm = searchInput.value.trim();
      if (searchTerm) params.set('search', searchTerm);
      const response = await fetch(`/api/vendor-products/client-visible?${params.toString()}`, { headers: { Accept: 'application/json' } });
      const data = await response.json();
      if (!data.success) {
        productsGrid.innerHTML = `<p class="cart-empty">${escapeHtml(data.message || 'Unable to load products')}</p>`;
        return;
      }

      allLoadedProductsMap = {};
      (data.products || []).forEach(p => {
        allLoadedProductsMap[p.id] = p;
      });

      productsGrid.innerHTML = data.products.length
        ? data.products.map(productCard).join('')
        : '<p class="cart-empty">No products found</p>';
      trackVisibleProducts(data.products || []);
    }

    async function loadSuggestions() {
      const q = searchInput.value.trim();
      if (!q) {
        suggestionsPanel.hidden = true;
        suggestionsPanel.innerHTML = '';
        return;
      }

      const response = await fetch(`/api/vendor-products/client-visible/suggestions?q=${encodeURIComponent(q)}`, { headers: { Accept: 'application/json' } });
      const data = await response.json();
      const suggestions = data.success ? data.suggestions || [] : [];
      if (!suggestions.length) {
        suggestionsPanel.hidden = true;
        suggestionsPanel.innerHTML = '';
        return;
      }

      suggestionsPanel.innerHTML = suggestions.map((item) => `
        <button type="button" class="suggestion-item" onclick="selectSuggestion('${escapeAttr(item.label)}')">
          <span>${escapeHtml(item.label)}</span>
          <small>${escapeHtml(item.type)}</small>
        </button>
      `).join('');
      suggestionsPanel.hidden = false;
    }

    async function loadPromotionScroll() {
      try {
        const response = await fetch('/api/promotions/active-display', { headers: { Accept: 'application/json' } });
        const data = await response.json();
        const promotions = data.success ? data.promotions || [] : [];
        const shell = document.getElementById('promoScrollShell');
        const track = document.getElementById('promoScrollTrack');
        if (!promotions.length) {
          shell.hidden = true;
          return;
        }

        const items = promotions.map((promo) => `
          <span class="promo-scroll-item" style="background:${escapeHtml(promo.background_color || '#0f766e')};color:${escapeHtml(promo.text_color || '#ffffff')}">
            ${promo.image_path ? `<img src="${escapeHtml(promo.image_path)}" alt="">` : ''}
            <strong>${escapeHtml(promo.scroll_message)}</strong>
            ${promo.code ? `<em>Code: ${escapeHtml(promo.code)}</em>` : ''}
          </span>
        `).join('');
        track.innerHTML = items + items;
        shell.hidden = false;
      } catch (error) {
        document.getElementById('promoScrollShell').hidden = true;
      }
    }

    function escapeAttr(value) {
      return String(value || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/\r?\n/g, ' ');
    }

    function selectSuggestion(value) {
      searchInput.value = value;
      suggestionsPanel.hidden = true;
      loadProducts();
    }

    function trackProductActivity(type, productId) {
      if (!productId) return;
      fetch('/api/vendor-products/client-visible/activity', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type, product_id: productId, keyword: searchInput.value.trim() }),
      }).catch(() => {});
    }

    function trackVisibleProducts(items) {
      items.slice(0, 12).forEach((product) => trackProductActivity('view', product.product_id));
    }

    function handleProductAddToCart(button) {
      const id = Number(button.dataset.id);
      const product = allLoadedProductsMap[id];
      if (product && product.variants && product.variants.length > 0) {
        openVariationSideCard(product);
      } else {
        addToCartFromButton(button);
      }
    }

    function openVariationSideCard(product) {
      currentSelectedProduct = product;
      currentSelectedVariantQty = 1;
      document.getElementById('var-selected-qty').value = 1;

      document.getElementById('var-side-product-name').textContent = product.product_name || 'Product Options';
      document.getElementById('var-side-product-category').textContent = product.category_name || '';
      document.getElementById('var-side-product-img').src = product.image_url || '/default.png';

      const prices = (product.variants || []).map(v => v.price).filter(p => p > 0);
      const minPrice = prices.length ? Math.min(...prices) : (product.visible_price || 0);
      const maxPrice = prices.length ? Math.max(...prices) : (product.visible_price || 0);
      document.getElementById('var-side-price-range').textContent = minPrice === maxPrice
        ? `₹${minPrice.toFixed(2)}`
        : `₹${minPrice.toFixed(2)} - ₹${maxPrice.toFixed(2)}`;

      const variants = product.variants && product.variants.length ? product.variants : [{
        id: product.id,
        variant_name: product.weight_label || 'Default Option',
        price: product.visible_price || 0,
        mrp: product.default_price || product.visible_price || 0,
        stock: product.quantity || 100,
      }];

      currentSelectedVariant = variants[0];
      renderVariationCards(variants);
      updateVariationFooterButton();
      document.getElementById('variation-side-section').style.display = 'flex';
    }

    function closeVariationSideCard() {
      document.getElementById('variation-side-section').style.display = 'none';
      currentSelectedProduct = null;
      currentSelectedVariant = null;
    }

    function selectVariationOption(variantId) {
      if (!currentSelectedProduct) return;
      const variants = currentSelectedProduct.variants || [];
      const found = variants.find(v => Number(v.id) === Number(variantId));
      if (found) {
        currentSelectedVariant = found;
        renderVariationCards(variants);
        updateVariationFooterButton();
      }
    }

    function renderVariationCards(variants) {
      const container = document.getElementById('variation-cards-container');
      container.innerHTML = variants.map(v => {
        const isSelected = currentSelectedVariant && Number(v.id) === Number(currentSelectedVariant.id);
        const name = v.variant_name || v.name || `${v.weight_value || ''} ${v.weight_unit || ''}`.trim() || 'Option';
        const price = Number(v.price || 0);
        const mrp = Number(v.mrp || 0);
        const hasDiscount = mrp > price;
        const savings = hasDiscount ? (mrp - price).toFixed(0) : 0;
        const inStock = (v.stock || v.stock_quantity || 0) > 0;

        return `
          <div class="var-option-card ${isSelected ? 'selected' : ''}" onclick="selectVariationOption(${v.id})">
            <div class="var-card-left">
              <div class="var-radio"></div>
              <div>
                <div class="var-name">${escapeHtml(name)}</div>
                <span class="var-stock-badge ${inStock ? '' : 'out-stock'}">
                  ${inStock ? 'In Stock' : 'Out of Stock'}
                </span>
              </div>
            </div>
            <div class="var-card-right">
              ${hasDiscount ? `<div class="var-card-mrp">₹${mrp.toFixed(0)}</div>` : ''}
              <div class="var-card-price">₹${price.toFixed(2)}</div>
              ${hasDiscount ? `<div class="var-savings-tag">Save ₹${savings}</div>` : ''}
            </div>
          </div>
        `;
      }).join('');
    }

    function changeVariationQty(delta) {
      currentSelectedVariantQty = Math.max(1, currentSelectedVariantQty + delta);
      document.getElementById('var-selected-qty').value = currentSelectedVariantQty;
      updateVariationFooterButton();
    }

    function updateVariationFooterButton() {
      const btn = document.getElementById('btn-add-variation-cart');
      if (!currentSelectedVariant) {
        btn.textContent = 'Add to Cart';
        return;
      }
      const name = currentSelectedVariant.variant_name || currentSelectedVariant.name || 'Option';
      const price = Number(currentSelectedVariant.price || 0) * currentSelectedVariantQty;
      btn.textContent = `Add ${escapeHtml(name)} (₹${price.toFixed(2)})`;
    }

    function addSelectedVariationToCart() {
      if (!currentSelectedProduct || !currentSelectedVariant) return;

      if (!categoryFilter.value || !currentSelectedProduct.category_id) {
        alert('Please select a main category before adding products for quotation.');
        return;
      }

      const variantName = currentSelectedVariant.variant_name || currentSelectedVariant.name || 'Option';
      const fullName = `${currentSelectedProduct.product_name} (${variantName})`;
      const price = Number(currentSelectedVariant.price || 0);
      const maxQty = Number(currentSelectedVariant.stock || currentSelectedVariant.stock_quantity || currentSelectedProduct.quantity || 100);

      addToCart(
        currentSelectedProduct.id,
        fullName,
        price,
        maxQty,
        currentSelectedProduct.id,
        currentSelectedVariantQty,
        variantName,
        currentSelectedVariant.weight_in_grams ? currentSelectedVariant.weight_in_grams / 1000 : (currentSelectedProduct.weight_kg || 0),
        currentSelectedProduct.category_id,
        currentSelectedProduct.category_name
      );

      trackProductActivity('click', currentSelectedProduct.product_id);
      closeVariationSideCard();
    }

    function updateCartCount() {
      const count = cart.reduce((sum, item) => sum + item.quantity, 0);
      document.getElementById('cart-count').textContent = count;
      document.getElementById('cart-count').style.display = count > 0 ? 'block' : 'none';
    }

    function addToCartFromButton(button) {
      const card = button.closest('.product-card');
      const quantityInput = card.querySelector('.qty-input');
      const id = Number(button.dataset.id);
      const vendorProductId = Number(button.dataset.vendorProductId);
      const masterProductId = Number(button.dataset.masterProductId);
      const name = button.dataset.name;
      const price = Number(button.dataset.price);
      const categoryId = Number(button.dataset.categoryId);
      const categoryName = button.dataset.categoryName || '';
      const weightLabel = button.dataset.weightLabel || '';
      const weightKg = Number(button.dataset.weightKg || 0);
      const maxQty = Number(button.dataset.maxQty);
      const requestedQty = Math.min(Math.max(1, Number(quantityInput.value) || 1), maxQty);

      if (!categoryFilter.value || !categoryId) {
        alert('Please select a main category before adding products for quotation.');
        return;
      }

      addToCart(id, name, price, maxQty, vendorProductId, requestedQty, weightLabel, weightKg, categoryId, categoryName);
      trackProductActivity('click', masterProductId);
      quantityInput.value = 1;
    }

    function addToCart(id, name, price, maxQty, vendorProductId, requestedQty = 1, weightLabel = '', weightKg = 0, categoryId = null, categoryName = '') {
      const existingItem = cart.find(item => item.id === id);
      if (existingItem) {
        existingItem.quantity = Math.min(existingItem.quantity + requestedQty, maxQty);
        existingItem.weightLabel = weightLabel || existingItem.weightLabel || '';
        existingItem.weightKg = Number(weightKg || existingItem.weightKg || 0);
        existingItem.categoryId = categoryId || existingItem.categoryId || null;
        existingItem.categoryName = categoryName || existingItem.categoryName || '';
      } else {
        cart.push({ id, vendorProductId, name, price, quantity: requestedQty, maxQty, weightLabel, weightKg, categoryId, categoryName });
      }
      updateCartCount();
      renderCart();
      saveCart();
      openCart();
    }

    function removeFromCart(id) {
      cart = cart.filter(item => item.id !== id);
      updateCartCount();
      renderCart();
      saveCart();
    }

    function updateQuantity(id, newQty) {
      const item = cart.find(item => item.id === id);
      if (item) {
        item.quantity = Math.min(Math.max(1, newQty), item.maxQty);
        updateCartCount();
        renderCart();
        saveCart();
      }
    }

    function renderCart() {
      const cartItems = document.getElementById('cart-items');
      const cartSummary = document.getElementById('cart-summary');
      const cartTotal = document.getElementById('cart-total-amount');

      if (cart.length === 0) {
        cartItems.innerHTML = '<p class="cart-empty">Your cart is empty</p>';
        cartSummary.style.display = 'none';
      } else {
        cartItems.innerHTML = cart.map(item => `
          <div class="cart-item">
            <div class="cart-item-info">
              <strong>${escapeHtml(item.name)}</strong>
              <span>Unit price: ₹${item.price.toFixed(2)}</span>
              ${item.weightLabel ? `<span>Weight: ${escapeHtml(item.weightLabel)} x ${item.quantity} = ${Number((item.weightKg || 0) * item.quantity).toFixed(3)} kg</span>` : ''}
            </div>
            <div class="cart-item-actions">
              <button type="button" onclick="updateQuantity(${item.id}, ${item.quantity - 1})" ${item.quantity <= 1 ? 'disabled' : ''}>-</button>
              <span>${item.quantity}</span>
              <button type="button" onclick="updateQuantity(${item.id}, ${item.quantity + 1})" ${item.quantity >= item.maxQty ? 'disabled' : ''}>+</button>
              <button type="button" onclick="removeFromCart(${item.id})" class="remove-btn">&times;</button>
            </div>
          </div>
        `).join('');

        const total = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
        cartTotal.textContent = '₹' + total.toFixed(2);
        cartSummary.style.display = 'block';
      }
    }

    function openCart() {
      document.getElementById('cart-section').style.display = 'block';
    }

    function closeCart() {
      document.getElementById('cart-section').style.display = 'none';
    }

    function clearCartAfterSuccess() {
      cart = [];
      updateCartCount();
      renderCart();
      saveCart();
      closeCart();
    }

    function money(value) {
      return 'INR ' + Number(value || 0).toFixed(2);
    }

    function paymentSummaryHtml(preview) {
      const vendors = preview.vendors || [];
      return `
        <div class="payment-card">
          <div class="payment-address">
            <span>Deliver to</span>
            <strong>${escapeHtml(preview.address && preview.address.recipient_name || 'Customer')}</strong>
            <p>${escapeHtml(preview.address && preview.address.display_address || '')}</p>
          </div>
          <div class="payment-line"><span>Item subtotal</span><strong>${money(preview.subtotal_amount)}</strong></div>
          <div class="payment-line"><span>Discount</span><strong>- ${money(preview.discount_amount)}</strong></div>
          <div class="payment-line"><span>Platform fee</span><strong>${money(preview.platform_fee || 0)}</strong></div>
          <div class="payment-line"><span>Delivery charges</span><strong>${money(preview.delivery_charge)}</strong></div>
          <div class="payment-line payment-total"><span>Payable amount</span><strong>${money(preview.total_amount)}</strong></div>
          ${vendors.length ? `
            <div class="vendor-delivery-breakdown">
              ${vendors.map((vendor) => `
                <div>
                  <strong>Vendor #${vendor.vendor_id}</strong>
                  <span>${money(vendor.delivery_charge)} delivery${Number(vendor.distance_km || 0) > 0 ? ` - ${Number(vendor.distance_km).toFixed(2)} km` : ''}</span>
                </div>
              `).join('')}
            </div>
          ` : ''}
          <p class="payment-note">Temporary payment page. No online gateway is connected yet.</p>
        </div>
      `;
    }

    function openPaymentPage(preview) {
      pendingPaymentPreview = preview;
      document.getElementById('payment-summary').innerHTML = paymentSummaryHtml(preview);
      document.getElementById('payment-section').style.display = 'block';
    }

    function closePaymentPage() {
      document.getElementById('payment-section').style.display = 'none';
    }

    async function directOrder() {
      if (cart.length === 0) return;

      const button = document.querySelector('.btn-checkout');
      if (button) button.disabled = true;
      try {
        const response = await fetch('/client/orders/preview', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: cart, coupon_code: document.getElementById('cart-coupon-code').value.trim() })
        });
        const data = await response.json();
        if (!data.success) {
          alert(data.message || 'Unable to calculate delivery charge');
          return;
        }
        openPaymentPage(data.preview);
      } catch (error) {
        alert('Error opening payment page: ' + error.message);
      } finally {
        if (button) button.disabled = false;
      }
    }

    async function confirmDirectOrder() {
      if (cart.length === 0) return;
      const button = document.getElementById('confirm-payment-button');
      button.disabled = true;
      button.textContent = 'Processing...';

      fetch('/client/orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: cart, coupon_code: document.getElementById('cart-coupon-code').value.trim() })
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          alert(`Order placed successfully! Delivery charge: ${money(pendingPaymentPreview && pendingPaymentPreview.delivery_charge || 0)}`);
          closePaymentPage();
          clearCartAfterSuccess();
        } else {
          alert(data.message || 'Failed to place order');
        }
      })
      .catch(error => {
        alert('Error placing order: ' + error.message);
      })
      .finally(() => {
        button.disabled = false;
        button.textContent = 'Pay & Place Order';
      });
    }

    function sendQuotation() {
      if (cart.length === 0) return;
      if (cart.some((item) => !item.categoryId)) {
        alert('Please select a main category first, then add products for quotation.');
        return;
      }

      fetch('/client/quotations', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: cart, coupon_code: document.getElementById('cart-coupon-code').value.trim() })
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          alert(data.message || 'Quotation sent successfully!');
          clearCartAfterSuccess();
        } else {
          alert(data.message || 'Failed to send quotation');
        }
      })
      .catch(error => {
        alert('Error sending quotation: ' + error.message);
      });
    }

    function decreaseQty(btn) {
      const input = btn.nextElementSibling;
      const newVal = Math.max(1, parseInt(input.value) - 1);
      input.value = newVal;
    }

    function increaseQty(btn) {
      const input = btn.previousElementSibling;
      const maxVal = parseInt(input.max);
      const newVal = Math.min(maxVal, parseInt(input.value) + 1);
      input.value = newVal;
    }

    updateCartCount();
    renderCart();
    loadPromotionScroll();
    restoreSelectedCategory();
    renderCategoryGrid();
    updateSubcategoryFilter();
    updateBrandFilter();
    loadProducts();
    categoryFilter.addEventListener('change', () => {
      saveSelectedCategory();
      updateSubcategoryFilter();
      subcategoryFilter.value = '';
      updateBrandFilter();
      renderCategoryGrid();
      loadProducts();
    });
    subcategoryFilter.addEventListener('change', () => {
      updateBrandFilter();
      loadProducts();
    });
    brandFilter.addEventListener('change', loadProducts);
    const debouncedSearch = debounce(() => {
      loadSuggestions();
      loadProducts();
    }, 300);
    searchInput.addEventListener('input', debouncedSearch);
    document.addEventListener('click', (event) => {
      if (!event.target.closest('.search-box-container')) {
        suggestionsPanel.hidden = true;
      }
    });
    setInterval(refreshCatalog, 5000);
  </script>

