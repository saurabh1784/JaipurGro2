<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Groxen - Unified Access Portal</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css" />
  <style>
    :root {
      --bg-dark: #0b0f19;
      --bg-card: rgba(17, 24, 39, 0.85);
      --border-dark: rgba(255, 255, 255, 0.1);
      --primary: #10b981;
      --primary-hover: #059669;
      --accent-blue: #3b82f6;
      --accent-orange: #f97316;
      --accent-purple: #8b5cf6;
      --text-light: #f8fafc;
      --text-muted: #94a3b8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg-dark);
      background-image: 
        radial-gradient(circle at 20% 20%, rgba(16, 185, 129, 0.15) 0%, transparent 40%),
        radial-gradient(circle at 80% 80%, rgba(59, 130, 246, 0.12) 0%, transparent 40%),
        radial-gradient(circle at 50% 50%, rgba(139, 92, 246, 0.08) 0%, transparent 50%);
      min-height: 100vh;
      color: var(--text-light);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow-x: hidden;
    }

    .landing-header {
      padding: 2rem 3rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border-dark);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      text-decoration: none;
      color: var(--text-light);
    }

    .brand-logo-mark {
      width: 44px;
      height: 44px;
      background: linear-gradient(135deg, #10b981 0%, #047857 100%);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
      box-shadow: 0 8px 20px -4px rgba(16, 185, 129, 0.4);
    }

    .brand-title {
      font-size: 1.4rem;
      font-weight: 800;
      letter-spacing: -0.03em;
    }

    .main-content {
      max-width: 1100px;
      margin: 0 auto;
      padding: 4rem 1.5rem;
      width: 100%;
      text-align: center;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: #34d399;
      padding: 0.45rem 1.1rem;
      border-radius: 9999px;
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
    }

    .hero-title {
      font-size: 3rem;
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -0.03em;
      margin-bottom: 1rem;
      background: linear-gradient(135deg, #ffffff 30%, #94a3b8 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-subtitle {
      font-size: 1.15rem;
      color: var(--text-muted);
      max-width: 620px;
      margin: 0 auto 3.5rem auto;
      line-height: 1.6;
    }

    .portals-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.75rem;
      margin-bottom: 3rem;
    }

    .portal-card {
      background: var(--bg-card);
      border: 1px solid var(--border-dark);
      border-radius: 24px;
      padding: 2.25rem 1.75rem;
      text-decoration: none;
      color: var(--text-light);
      display: flex;
      flex-direction: column;
      align-items: center;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    .portal-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: transparent;
      transition: background 0.3s ease;
    }

    .portal-card.admin::before { background: linear-gradient(90deg, #3b82f6, #60a5fa); }
    .portal-card.vendor::before { background: linear-gradient(90deg, #f97316, #fb923c); }
    .portal-card.delivery::before { background: linear-gradient(90deg, #10b981, #34d399); }
    .portal-card.client::before { background: linear-gradient(90deg, #8b5cf6, #a78bfa); }

    .portal-card:hover {
      transform: translateY(-6px);
      border-color: rgba(255, 255, 255, 0.25);
      box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
    }

    .portal-icon {
      width: 64px;
      height: 64px;
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.25rem;
      transition: transform 0.3s ease;
    }

    .portal-card:hover .portal-icon {
      transform: scale(1.08);
    }

    .portal-card.admin .portal-icon {
      background: rgba(59, 130, 246, 0.15);
      color: #60a5fa;
      border: 1px solid rgba(59, 130, 246, 0.3);
    }

    .portal-card.vendor .portal-icon {
      background: rgba(249, 115, 22, 0.15);
      color: #fb923c;
      border: 1px solid rgba(249, 115, 22, 0.3);
    }

    .portal-card.delivery .portal-icon {
      background: rgba(16, 185, 129, 0.15);
      color: #34d399;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .portal-card.client .portal-icon {
      background: rgba(139, 92, 246, 0.15);
      color: #a78bfa;
      border: 1px solid rgba(139, 92, 246, 0.3);
    }

    .portal-name {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
    }

    .portal-desc {
      font-size: 0.875rem;
      color: var(--text-muted);
      line-height: 1.45;
      margin-bottom: 1.5rem;
    }

    .portal-btn {
      width: 100%;
      padding: 0.8rem 1.25rem;
      border-radius: 14px;
      font-weight: 700;
      font-size: 0.9rem;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      transition: all 0.2s ease;
    }

    .portal-card.admin .portal-btn { background: #3b82f6; color: #ffffff; }
    .portal-card.admin .portal-btn:hover { background: #2563eb; }

    .portal-card.vendor .portal-btn { background: #f97316; color: #ffffff; }
    .portal-card.vendor .portal-btn:hover { background: #ea580c; }

    .portal-card.delivery .portal-btn { background: #10b981; color: #ffffff; }
    .portal-card.delivery .portal-btn:hover { background: #059669; }

    .portal-card.client .portal-btn { background: #8b5cf6; color: #ffffff; }
    .portal-card.client .portal-btn:hover { background: #7c3aed; }

    .landing-footer {
      padding: 2rem 1.5rem;
      text-align: center;
      font-size: 0.85rem;
      color: var(--text-muted);
      border-top: 1px solid var(--border-dark);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    @media (max-width: 640px) {
      .landing-header { padding: 1.25rem; }
      .hero-title { font-size: 2.1rem; }
      .hero-subtitle { font-size: 1rem; }
      .main-content { padding: 2.5rem 1rem; }
    }
  </style>
</head>
<body>

  <!-- Top Header -->
  <header class="landing-header">
    <a href="/" class="brand-logo">
      <div class="brand-logo-mark">
        <svg viewBox="0 0 48 48" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 27h24l-3 12H15z" />
          <path d="M15 26c0-7 4-12 9-12s9 5 9 12" />
          <path d="M17 18c-3-3-3-7 1-10 5 1 8 4 7 9" fill="currentColor" stroke="none" />
          <path d="M27 17c-1-5 2-9 7-10 4 4 3 9-1 12" fill="#ff8a00" stroke="none" />
          <path d="M10 27h28M15 39h18M14 31h21" />
        </svg>
      </div>
      <span class="brand-title">Groxen System</span>
    </a>
  </header>

  <!-- Main Hero & Portals -->
  <main class="main-content">
    <div class="hero-badge">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      Unified Operations Portal
    </div>

    <h1 class="hero-title">Groxen Management Center</h1>
    <p class="hero-subtitle">Select your role to access management dashboards, vendor portals, and delivery management systems.</p>

    <div class="portals-grid">
      <!-- Admin Portal -->
      <a href="/admin" class="portal-card admin">
        <div class="portal-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><circle cx="12" cy="11" r="3"/></svg>
        </div>
        <h2 class="portal-name">Admin Portal</h2>
        <p class="portal-desc">Manage system operations, city logistics, users, and store settings.</p>
        <button class="portal-btn">
          Open Admin Login
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>
      </a>

      <!-- Vendor Portal -->
      <a href="/login/vendor" class="portal-card vendor">
        <div class="portal-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </div>
        <h2 class="portal-name">Vendor Portal</h2>
        <p class="portal-desc">Access product catalog, manage inventory, prices, and track orders.</p>
        <button class="portal-btn">
          Open Vendor Login
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>
      </a>

      <!-- Delivery Partner -->
      <a href="/login/delivery" class="portal-card delivery">
        <div class="portal-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        </div>
        <h2 class="portal-name">Delivery Partner</h2>
        <p class="portal-desc">Log in to view assigned deliveries, route updates, and order status.</p>
        <button class="portal-btn">
          Open Delivery Login
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>
      </a>

      <!-- Customer / Client -->
      <a href="/login/client" class="portal-card client">
        <div class="portal-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        </div>
        <h2 class="portal-name">Customer Portal</h2>
        <p class="portal-desc">Shop fresh groceries, track live orders, and manage account details.</p>
        <button class="portal-btn">
          Open Customer Login
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>
      </a>
    </div>
  </main>

  <!-- Footer -->
  <footer class="landing-footer">
    <p><a href="/superadmin" style="color: #ef4444; font-weight: 700; text-decoration: none;">⚡ Superadmin Access Portal</a></p>
    <p>A product by Shining Universal Organisation Private Limited • groxen is a child organisation of Shining Universal Organisation Private Limited</p>
  </footer>

</body>
</html>
