<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css" />
  <style>
    .app-settings-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 24px;
      margin-top: 24px;
    }
    .logo-card {
      background: var(--surface-color, #ffffff);
      border: 1px solid var(--border-color, #e2e8f0);
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      display: flex;
      flex-direction: column;
    }
    .logo-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    }
    .logo-card-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border-color, #f1f5f9);
    }
    .logo-badge {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      color: #fff;
    }
    .logo-badge.client { background: linear-gradient(135deg, #10b981, #059669); }
    .logo-badge.vendor { background: linear-gradient(135deg, #6366f1, #4f46e5); }
    .logo-badge.delivery { background: linear-gradient(135deg, #f59e0b, #d97706); }
    
    .logo-preview-box {
      width: 100%;
      height: 160px;
      border-radius: 12px;
      background: #f8fafc;
      border: 2px dashed #cbd5e1;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 18px;
      overflow: hidden;
      position: relative;
      cursor: pointer;
      transition: border-color 0.2s, background 0.2s;
    }
    .logo-preview-box:hover {
      border-color: #6366f1;
      background: #f1f5f9;
    }
    .logo-preview-box img {
      max-width: 85%;
      max-height: 85%;
      object-fit: contain;
    }
    .logo-placeholder-text {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      color: #64748b;
      font-size: 13.5px;
      font-weight: 600;
      text-align: center;
      width: 100%;
      height: 100%;
      padding: 16px;
      box-sizing: border-box;
    }
    .logo-placeholder-text svg {
      stroke: #94a3b8;
      transition: stroke 0.2s, transform 0.2s;
    }
    .logo-preview-box:hover .logo-placeholder-text svg {
      stroke: #6366f1;
      transform: translateY(-2px);
    }
    .logo-placeholder-text span {
      color: #64748b;
    }
    .logo-preview-box:hover .logo-placeholder-text span {
      color: #4f46e5;
    }

    .form-section-title {
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      color: #64748b;
      margin: 16px 0 10px;
      letter-spacing: 0.5px;
    }
    .file-input-wrapper {
      margin-bottom: 14px;
    }
    .file-input-wrapper label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #475569;
      margin-bottom: 6px;
    }
    .url-fallback-input {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      font-size: 13px;
      margin-top: 4px;
      box-sizing: border-box;
    }
    .url-fallback-input:focus {
      border-color: #6366f1;
      outline: none;
    }
    .save-settings-bar {
      margin-top: 28px;
      background: #ffffff;
      padding: 20px 24px;
      border-radius: 16px;
      border: 1px solid #e2e8f0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    .submit-btn {
      background: linear-gradient(135deg, #10b981, #059669);
      color: #fff;
      padding: 12px 28px;
      border-radius: 10px;
      border: none;
      font-weight: 600;
      font-size: 15px;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3);
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .submit-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(16, 185, 129, 0.4);
    }
    .system-alert-success {
      background: #dcfce7;
      color: #166534;
      border: 1px solid #bbf7d0;
      padding: 14px 18px;
      border-radius: 10px;
      margin-bottom: 20px;
      font-weight: 600;
    }
    .system-alert-danger {
      background: #fee2e2;
      color: #991b1b;
      border: 1px solid #fca5a5;
      padding: 14px 18px;
      border-radius: 10px;
      margin-bottom: 20px;
      font-weight: 600;
    }
  </style>
</head>
<body class="system-theme">
  <%- include('partials/system_sidebar', { shell }) %>

  <main class="system-main">
    <header class="topbar">
      <div>
        <p class="crumb">System / App Settings</p>
        <h1>App Logos & Store Links Management</h1>
      </div>
      <div class="topbar-actions">
        <span class="badge" style="background:#e0e7ff; color:#3730a3; padding: 6px 12px; border-radius: 20px; font-weight:600;">
          Multi-App Unified Config
        </span>
      </div>
    </header>

    <% if (typeof message !== 'undefined' && message) { %>
      <div class="system-alert-success">✓ <%= message %></div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="system-alert-danger">⚠ <%= error %></div>
    <% } %>

    <form action="/app-settings/logos" method="POST" enctype="multipart/form-data">
      <div class="app-settings-grid">
        
        <!-- CLIENT APP CARD -->
        <div class="logo-card">
          <div class="logo-card-header">
            <div class="logo-badge client">C</div>
            <div>
              <h3 style="margin:0; font-size:17px; font-weight:700;">Client App</h3>
              <span style="font-size:12px; color:#64748b;">Customer Shopping Mobile & Web App</span>
            </div>
          </div>
          
          <div class="logo-preview-box" onclick="document.getElementById('client_app_logo').click();" title="Click to upload logo">
            <img id="previewClient" 
                 src="<%= settings.clientAppLogo || '' %>" 
                 alt="Client App Logo" 
                 onload="handleLogoLoad(this, 'placeholderClient')" 
                 onerror="handleLogoError(this, 'placeholderClient')" 
                 style="<%= settings.clientAppLogo ? '' : 'display:none;' %>" />
            
            <div id="placeholderClient" class="logo-placeholder-text" style="<%= settings.clientAppLogo ? 'display:none;' : 'display:flex;' %>">
              <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span>Upload a new logo</span>
            </div>
          </div>
          
          <div class="file-input-wrapper">
            <label for="client_app_logo">Upload Logo Image File (PNG, JPG, SVG)</label>
            <input type="file" id="client_app_logo" name="client_app_logo" accept="image/*" onchange="previewImage(this, 'previewClient', 'placeholderClient')" style="font-size:13px;" />
          </div>
          
          <div class="file-input-wrapper">
            <label for="client_app_logo_url">Or Custom Logo Image Path / URL</label>
            <input type="text" id="client_app_logo_url" name="client_app_logo_url" class="url-fallback-input" placeholder="/uploads/app_settings/client_logo.png" value="<%= settings.clientAppLogo %>" />
          </div>

          <div class="form-section-title">📱 App Share & Store Links</div>
          <div class="file-input-wrapper">
            <label for="client_app_playstore_url">🤖 Google Play Store Link</label>
            <input type="url" id="client_app_playstore_url" name="client_app_playstore_url" class="url-fallback-input" placeholder="https://play.google.com/store/apps/details?id=com.jaipurgro.client" value="<%= settings.clientPlayStore %>" />
          </div>
          <div class="file-input-wrapper">
            <label for="client_app_appstore_url">🍏 Apple App Store Link</label>
            <input type="url" id="client_app_appstore_url" name="client_app_appstore_url" class="url-fallback-input" placeholder="https://apps.apple.com/app/jaipurgro-client/id123456789" value="<%= settings.clientAppStore %>" />
          </div>

          <div class="form-section-title">🔄 App Update Settings</div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
            <div class="file-input-wrapper">
              <label for="client_latest_version">Latest App Version</label>
              <input type="text" id="client_latest_version" name="client_latest_version" class="url-fallback-input" placeholder="1.0.0" value="<%= settings.clientLatestVersion %>" />
            </div>
            <div class="file-input-wrapper">
              <label for="client_min_version">Minimum Supported Version</label>
              <input type="text" id="client_min_version" name="client_min_version" class="url-fallback-input" placeholder="1.0.0" value="<%= settings.clientMinVersion %>" />
            </div>
          </div>

          <div class="file-input-wrapper" style="margin-top: 6px; display: flex; align-items: center; gap: 10px; background: #f8fafc; padding: 10px 12px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <input type="checkbox" id="client_force_update" name="client_force_update" value="true" <%= settings.clientForceUpdate ? 'checked' : '' %> style="width: 18px; height: 18px; cursor: pointer;" />
            <label for="client_force_update" style="margin: 0; cursor: pointer; font-weight: 600; color: #1e293b;">Force Update (Enforce for all users)</label>
          </div>

          <div class="file-input-wrapper" style="margin-top: 12px;">
            <label for="client_update_title">Update Title</label>
            <input type="text" id="client_update_title" name="client_update_title" class="url-fallback-input" placeholder="Update Available" value="<%= settings.clientUpdateTitle %>" />
          </div>

          <div class="file-input-wrapper">
            <label for="client_update_message">Update Message</label>
            <textarea id="client_update_message" name="client_update_message" class="url-fallback-input" rows="3" style="resize: vertical; font-family: inherit;" placeholder="A new version of the app is available. Please update to continue."><%= settings.clientUpdateMessage %></textarea>
          </div>
        </div>

        <!-- VENDOR APP CARD -->
        <div class="logo-card">
          <div class="logo-card-header">
            <div class="logo-badge vendor">V</div>
            <div>
              <h3 style="margin:0; font-size:17px; font-weight:700;">Vendor App</h3>
              <span style="font-size:12px; color:#64748b;">Vendor Partner Management App</span>
            </div>
          </div>
          
          <div class="logo-preview-box" onclick="document.getElementById('vendor_app_logo').click();" title="Click to upload logo">
            <img id="previewVendor" 
                 src="<%= settings.vendorAppLogo || '' %>" 
                 alt="Vendor App Logo" 
                 onload="handleLogoLoad(this, 'placeholderVendor')" 
                 onerror="handleLogoError(this, 'placeholderVendor')" 
                 style="<%= settings.vendorAppLogo ? '' : 'display:none;' %>" />
            
            <div id="placeholderVendor" class="logo-placeholder-text" style="<%= settings.vendorAppLogo ? 'display:none;' : 'display:flex;' %>">
              <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span>Upload a new logo</span>
            </div>
          </div>
          
          <div class="file-input-wrapper">
            <label for="vendor_app_logo">Upload Logo Image File (PNG, JPG, SVG)</label>
            <input type="file" id="vendor_app_logo" name="vendor_app_logo" accept="image/*" onchange="previewImage(this, 'previewVendor', 'placeholderVendor')" style="font-size:13px;" />
          </div>
          
          <div class="file-input-wrapper">
            <label for="vendor_app_logo_url">Or Custom Logo Image Path / URL</label>
            <input type="text" id="vendor_app_logo_url" name="vendor_app_logo_url" class="url-fallback-input" placeholder="/uploads/app_settings/vendor_logo.png" value="<%= settings.vendorAppLogo %>" />
          </div>

          <div class="form-section-title">📱 App Share & Store Links</div>
          <div class="file-input-wrapper">
            <label for="vendor_app_playstore_url">🤖 Google Play Store Link</label>
            <input type="url" id="vendor_app_playstore_url" name="vendor_app_playstore_url" class="url-fallback-input" placeholder="https://play.google.com/store/apps/details?id=com.jaipurgro.vendor" value="<%= settings.vendorPlayStore %>" />
          </div>
          <div class="file-input-wrapper">
            <label for="vendor_app_appstore_url">🍏 Apple App Store Link</label>
            <input type="url" id="vendor_app_appstore_url" name="vendor_app_appstore_url" class="url-fallback-input" placeholder="https://apps.apple.com/app/jaipurgro-vendor/id123456789" value="<%= settings.vendorAppStore %>" />
          </div>

          <div class="form-section-title">🔄 App Update Settings</div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
            <div class="file-input-wrapper">
              <label for="vendor_latest_version">Latest App Version</label>
              <input type="text" id="vendor_latest_version" name="vendor_latest_version" class="url-fallback-input" placeholder="1.0.0" value="<%= settings.vendorLatestVersion %>" />
            </div>
            <div class="file-input-wrapper">
              <label for="vendor_min_version">Minimum Supported Version</label>
              <input type="text" id="vendor_min_version" name="vendor_min_version" class="url-fallback-input" placeholder="1.0.0" value="<%= settings.vendorMinVersion %>" />
            </div>
          </div>

          <div class="file-input-wrapper" style="margin-top: 6px; display: flex; align-items: center; gap: 10px; background: #f8fafc; padding: 10px 12px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <input type="checkbox" id="vendor_force_update" name="vendor_force_update" value="true" <%= settings.vendorForceUpdate ? 'checked' : '' %> style="width: 18px; height: 18px; cursor: pointer;" />
            <label for="vendor_force_update" style="margin: 0; cursor: pointer; font-weight: 600; color: #1e293b;">Force Update (Enforce for all users)</label>
          </div>

          <div class="file-input-wrapper" style="margin-top: 12px;">
            <label for="vendor_update_title">Update Title</label>
            <input type="text" id="vendor_update_title" name="vendor_update_title" class="url-fallback-input" placeholder="Update Available" value="<%= settings.vendorUpdateTitle %>" />
          </div>

          <div class="file-input-wrapper">
            <label for="vendor_update_message">Update Message</label>
            <textarea id="vendor_update_message" name="vendor_update_message" class="url-fallback-input" rows="3" style="resize: vertical; font-family: inherit;" placeholder="A new version of the app is available. Please update to continue."><%= settings.vendorUpdateMessage %></textarea>
          </div>
        </div>

        <!-- DELIVERY APP CARD -->
        <div class="logo-card">
          <div class="logo-card-header">
            <div class="logo-badge delivery">D</div>
            <div>
              <h3 style="margin:0; font-size:17px; font-weight:700;">Delivery App</h3>
              <span style="font-size:12px; color:#64748b;">Delivery Rider Partner App</span>
            </div>
          </div>
          
          <div class="logo-preview-box" onclick="document.getElementById('delivery_app_logo').click();" title="Click to upload logo">
            <img id="previewDelivery" 
                 src="<%= settings.deliveryAppLogo || '' %>" 
                 alt="Delivery App Logo" 
                 onload="handleLogoLoad(this, 'placeholderDelivery')" 
                 onerror="handleLogoError(this, 'placeholderDelivery')" 
                 style="<%= settings.deliveryAppLogo ? '' : 'display:none;' %>" />
            
            <div id="placeholderDelivery" class="logo-placeholder-text" style="<%= settings.deliveryAppLogo ? 'display:none;' : 'display:flex;' %>">
              <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span>Upload a new logo</span>
            </div>
          </div>
          
          <div class="file-input-wrapper">
            <label for="delivery_app_logo">Upload Logo Image File (PNG, JPG, SVG)</label>
            <input type="file" id="delivery_app_logo" name="delivery_app_logo" accept="image/*" onchange="previewImage(this, 'previewDelivery', 'placeholderDelivery')" style="font-size:13px;" />
          </div>
          
          <div class="file-input-wrapper">
            <label for="delivery_app_logo_url">Or Custom Logo Image Path / URL</label>
            <input type="text" id="delivery_app_logo_url" name="delivery_app_logo_url" class="url-fallback-input" placeholder="/uploads/app_settings/delivery_logo.png" value="<%= settings.deliveryAppLogo %>" />
          </div>

          <div class="form-section-title">📱 App Share & Store Links</div>
          <div class="file-input-wrapper">
            <label for="delivery_app_playstore_url">🤖 Google Play Store Link</label>
            <input type="url" id="delivery_app_playstore_url" name="delivery_app_playstore_url" class="url-fallback-input" placeholder="https://play.google.com/store/apps/details?id=com.jaipurgro.delivery" value="<%= settings.deliveryPlayStore %>" />
          </div>
          <div class="file-input-wrapper">
            <label for="delivery_app_appstore_url">🍏 Apple App Store Link</label>
            <input type="url" id="delivery_app_appstore_url" name="delivery_app_appstore_url" class="url-fallback-input" placeholder="https://apps.apple.com/app/jaipurgro-delivery/id123456789" value="<%= settings.deliveryAppStore %>" />
          </div>

          <div class="form-section-title">🔄 App Update Settings</div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
            <div class="file-input-wrapper">
              <label for="delivery_latest_version">Latest App Version</label>
              <input type="text" id="delivery_latest_version" name="delivery_latest_version" class="url-fallback-input" placeholder="1.0.0" value="<%= settings.deliveryLatestVersion %>" />
            </div>
            <div class="file-input-wrapper">
              <label for="delivery_min_version">Minimum Supported Version</label>
              <input type="text" id="delivery_min_version" name="delivery_min_version" class="url-fallback-input" placeholder="1.0.0" value="<%= settings.deliveryMinVersion %>" />
            </div>
          </div>

          <div class="file-input-wrapper" style="margin-top: 6px; display: flex; align-items: center; gap: 10px; background: #f8fafc; padding: 10px 12px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <input type="checkbox" id="delivery_force_update" name="delivery_force_update" value="true" <%= settings.deliveryForceUpdate ? 'checked' : '' %> style="width: 18px; height: 18px; cursor: pointer;" />
            <label for="delivery_force_update" style="margin: 0; cursor: pointer; font-weight: 600; color: #1e293b;">Force Update (Enforce for all users)</label>
          </div>

          <div class="file-input-wrapper" style="margin-top: 12px;">
            <label for="delivery_update_title">Update Title</label>
            <input type="text" id="delivery_update_title" name="delivery_update_title" class="url-fallback-input" placeholder="Update Available" value="<%= settings.deliveryUpdateTitle %>" />
          </div>

          <div class="file-input-wrapper">
            <label for="delivery_update_message">Update Message</label>
            <textarea id="delivery_update_message" name="delivery_update_message" class="url-fallback-input" rows="3" style="resize: vertical; font-family: inherit;" placeholder="A new version of the app is available. Please update to continue."><%= settings.deliveryUpdateMessage %></textarea>
          </div>
        </div>

      </div>

      <div class="save-settings-bar">
        <div>
          <strong style="font-size:15px; color:#1e293b;">Save Changes</strong>
          <p style="margin:4px 0 0; font-size:13px; color:#64748b;">Changes update app logos and store share links across all mobile & web applications in real-time.</p>
        </div>
        <button type="submit" class="submit-btn">Save All App Settings</button>
      </div>
    </form>

    <!-- SOCIAL PROFILE SETTINGS CARD -->
    <div style="background:#ffffff; border:1px solid #e2e8f0; border-radius:16px; padding:24px; margin-top:32px; box-shadow:0 4px 20px rgba(0,0,0,0.04);">
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; padding-bottom:14px; border-bottom:1px solid #f1f5f9;">
        <div>
          <h3 style="margin:0; font-size:18px; font-weight:700; color:#1e293b;">🌐 Social Profile Settings</h3>
          <span style="font-size:13px; color:#64748b;">Manage social media channels, profiles & links shown in Client, Vendor, and Delivery apps</span>
        </div>
      </div>

      <!-- ADD NEW SOCIAL PROFILE FORM -->
      <form action="/app-settings/social-profiles" method="POST" enctype="multipart/form-data" style="margin-bottom:28px; background:#f8fafc; padding:20px; border-radius:12px; border:1px solid #e2e8f0;">
        <h4 style="margin:0 0 16px; font-size:15px; font-weight:700; color:#334155;">Add New Social Profile</h4>
        <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap:16px; margin-bottom:16px;">
          <div>
            <label style="display:block; font-size:12.5px; font-weight:600; color:#475569; margin-bottom:6px;">Profile / Channel Name</label>
            <input type="text" name="platform_name" placeholder="e.g. WhatsApp Channel" class="url-fallback-input" required />
          </div>

          <div>
            <label style="display:block; font-size:12.5px; font-weight:600; color:#475569; margin-bottom:6px;">Built-in Icon Name</label>
            <select name="icon_name" class="url-fallback-input">
              <option value="whatsapp">WhatsApp</option>
              <option value="facebook">Facebook</option>
              <option value="youtube">YouTube</option>
              <option value="instagram">Instagram</option>
              <option value="twitter">X / Twitter</option>
              <option value="telegram">Telegram</option>
              <option value="linkedin">LinkedIn</option>
              <option value="globe">Website / Globe</option>
            </select>
          </div>

          <div>
            <label style="display:block; font-size:12.5px; font-weight:600; color:#475569; margin-bottom:6px;">Custom Icon File (Optional)</label>
            <input type="file" name="icon_image_file" accept="image/*" style="font-size:12px;" />
          </div>

          <div>
            <label style="display:block; font-size:12.5px; font-weight:600; color:#475569; margin-bottom:6px;">Profile / Channel URL</label>
            <input type="url" name="profile_link" placeholder="https://..." class="url-fallback-input" required />
          </div>

          <div>
            <label style="display:block; font-size:12.5px; font-weight:600; color:#475569; margin-bottom:6px;">Display Order</label>
            <input type="number" name="display_order" value="0" min="0" class="url-fallback-input" required />
          </div>
        </div>

        <div style="display:flex; align-items:center; justify-content:space-between; margin-top:14px;">
          <label style="display:flex; align-items:center; gap:8px; font-size:13.5px; font-weight:600; cursor:pointer;">
            <input type="checkbox" name="is_active" value="on" checked style="width:18px; height:18px;" />
            Active (Visible in all apps)
          </label>
          <button type="submit" style="background:linear-gradient(135deg, #6366f1, #4f46e5); color:#fff; padding:9px 20px; border-radius:8px; border:none; font-weight:600; cursor:pointer; font-size:13.5px;">
            + Add Social Profile
          </button>
        </div>
      </form>

      <!-- SOCIAL PROFILES LIST TABLE -->
      <table style="width:100%; border-collapse:collapse;">
        <thead>
          <tr style="background:#f8fafc; text-align:left; font-size:12px; color:#64748b; text-transform:uppercase;">
            <th style="padding:10px 14px; border-bottom:1px solid #e2e8f0;">Order</th>
            <th style="padding:10px 14px; border-bottom:1px solid #e2e8f0;">Icon</th>
            <th style="padding:10px 14px; border-bottom:1px solid #e2e8f0;">Platform Name</th>
            <th style="padding:10px 14px; border-bottom:1px solid #e2e8f0;">URL Link</th>
            <th style="padding:10px 14px; border-bottom:1px solid #e2e8f0;">Status</th>
            <th style="padding:10px 14px; border-bottom:1px solid #e2e8f0;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof socialProfiles === 'undefined' || !socialProfiles || !socialProfiles.length) { %>
            <tr><td colspan="6" style="text-align:center; color:#94a3b8; padding:20px;">No social profiles added yet.</td></tr>
          <% } else { %>
            <% socialProfiles.forEach(sp => { %>
              <tr style="border-bottom:1px solid #f1f5f9; font-size:13.5px;">
                <td style="padding:12px 14px; font-weight:700;"><%= sp.display_order %></td>
                <td style="padding:12px 14px;">
                  <% if (sp.icon_image) { %>
                    <img src="<%= sp.icon_image %>" style="width:28px; height:28px; object-fit:contain; border-radius:6px;" alt="icon" />
                  <% } else { %>
                    <span style="background:#e0e7ff; color:#3730a3; padding:4px 8px; border-radius:6px; font-size:11px; font-weight:700; text-transform:uppercase;">
                      <%= sp.icon_name || 'globe' %>
                    </span>
                  <% } %>
                </td>
                <td style="padding:12px 14px; font-weight:600; color:#1e293b;"><%= sp.platform_name %></td>
                <td style="padding:12px 14px; max-width:240px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                  <a href="<%= sp.profile_link %>" target="_blank" style="color:#4f46e5; text-decoration:none;"><%= sp.profile_link %></a>
                </td>
                <td style="padding:12px 14px;">
                  <% if (sp.is_active) { %>
                    <span style="background:#dcfce7; color:#166534; padding:3px 8px; border-radius:12px; font-size:11px; font-weight:700;">ACTIVE</span>
                  <% } else { %>
                    <span style="background:#fee2e2; color:#991b1b; padding:3px 8px; border-radius:12px; font-size:11px; font-weight:700;">INACTIVE</span>
                  <% } %>
                </td>
                <td style="padding:12px 14px;">
                  <form action="/app-settings/social-profiles/toggle/<%= sp.id %>" method="POST" style="display:inline;">
                    <button type="submit" style="background:#f1f5f9; color:#475569; border:1px solid #cbd5e1; padding:4px 10px; border-radius:6px; cursor:pointer; font-size:12px; font-weight:600;">
                      <%= sp.is_active ? 'Deactivate' : 'Activate' %>
                    </button>
                  </form>
                  <form action="/app-settings/social-profiles/delete/<%= sp.id %>" method="POST" onsubmit="return confirm('Delete this social profile?');" style="display:inline;">
                    <button type="submit" style="background:#fee2e2; color:#991b1b; border:1px solid #fca5a5; padding:4px 10px; border-radius:6px; cursor:pointer; font-size:12px; font-weight:600;">
                      Delete
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>

  <script>
    function handleLogoError(imgEl, placeholderId) {
      imgEl.style.display = 'none';
      const placeholder = document.getElementById(placeholderId);
      if (placeholder) placeholder.style.display = 'flex';
    }

    function handleLogoLoad(imgEl, placeholderId) {
      if (imgEl.naturalWidth > 0 && imgEl.naturalHeight > 0) {
        imgEl.style.display = 'block';
        const placeholder = document.getElementById(placeholderId);
        if (placeholder) placeholder.style.display = 'none';
      } else {
        handleLogoError(imgEl, placeholderId);
      }
    }

    function previewImage(input, previewId, placeholderId) {
      if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
          const img = document.getElementById(previewId);
          const placeholder = document.getElementById(placeholderId);
          img.src = e.target.result;
          img.style.display = 'block';
          if (placeholder) placeholder.style.display = 'none';
        }
        reader.readAsDataURL(input.files[0]);
      }
    }
  </script>
</body>
</html>
