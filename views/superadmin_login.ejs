<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Superadmin Access Portal - Groxen</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css" />
  <style>
    :root {
      --bg-dark: #0b0f19;
      --card-bg: rgba(15, 23, 42, 0.92);
      --border-color: rgba(239, 68, 68, 0.3);
      --primary: #ef4444;
      --primary-dark: #dc2626;
      --primary-gradient: linear-gradient(135deg, #ef4444 0%, #991b1b 100%);
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg-dark);
      background-image: 
        radial-gradient(circle at 50% 0%, rgba(239, 68, 68, 0.18) 0%, transparent 60%),
        radial-gradient(circle at 80% 80%, rgba(139, 92, 246, 0.12) 0%, transparent 50%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      color: var(--text-main);
      position: relative;
      overflow-x: hidden;
    }

    .portal-container {
      width: 100%;
      max-width: 450px;
      position: relative;
      z-index: 1;
    }

    .portal-card {
      background: var(--card-bg);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid var(--border-color);
      border-radius: 32px;
      padding: 2.75rem 2.5rem;
      box-shadow: 0 30px 70px -15px rgba(0, 0, 0, 0.7), 0 0 30px rgba(239, 68, 68, 0.15);
      animation: fadeInCard 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes fadeInCard {
      from { opacity: 0; transform: translateY(18px) scale(0.98); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .site-logo-wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.5rem;
      text-decoration: none;
    }

    .site-logo-mark {
      width: 64px;
      height: 64px;
      background: var(--primary-gradient);
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
      box-shadow: 0 12px 28px -6px rgba(239, 68, 68, 0.5);
      margin-bottom: 0.75rem;
    }

    .site-brand-name {
      font-size: 1.85rem;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.035em;
    }

    .superadmin-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid rgba(239, 68, 68, 0.4);
      color: #fca5a5;
      padding: 4px 12px;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-top: 4px;
      margin-bottom: 12px;
    }

    .portal-header {
      text-align: center;
      margin-bottom: 1.75rem;
    }

    .portal-header h1 {
      margin: 0;
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -0.025em;
      color: #ffffff;
    }

    .portal-header p {
      margin: 0.4rem 0 0;
      font-size: 0.875rem;
      color: var(--text-muted);
      line-height: 1.45;
    }

    .error-alert {
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid rgba(239, 68, 68, 0.4);
      color: #fca5a5;
      padding: 0.85rem 1.1rem;
      border-radius: 16px;
      font-size: 0.875rem;
      font-weight: 600;
      margin-bottom: 1.35rem;
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    .form-group {
      margin-bottom: 1.25rem;
    }

    .form-group label {
      display: block;
      font-size: 0.775rem;
      font-weight: 800;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.5rem;
    }

    .input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
      width: 100%;
    }

    .input-icon {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      color: #64748b;
      pointer-events: none;
      z-index: 3;
    }

    .form-control {
      width: 100%;
      height: 52px;
      padding: 0 16px 0 48px;
      font-family: inherit;
      font-size: 0.95rem;
      border: 1.5px solid rgba(255, 255, 255, 0.15);
      border-radius: 16px;
      background: rgba(15, 23, 42, 0.8);
      color: #ffffff;
      transition: all 0.2s ease;
    }

    .form-control:focus {
      outline: none;
      border-color: #ef4444;
      box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.2);
    }

    .submit-btn {
      width: 100%;
      height: 52px;
      border: none;
      border-radius: 16px;
      background: var(--primary-gradient);
      color: #ffffff;
      font-weight: 700;
      font-size: 1rem;
      cursor: pointer;
      box-shadow: 0 12px 28px -6px rgba(239, 68, 68, 0.5);
      transition: all 0.25s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      margin-top: 1.25rem;
    }

    .submit-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 32px -6px rgba(239, 68, 68, 0.65);
    }

    .portal-footer {
      margin-top: 1.85rem;
      padding-top: 1.35rem;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      text-align: center;
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .portal-footer a {
      color: #fca5a5;
      text-decoration: none;
      font-weight: 700;
    }

  </style>
</head>
<%
  const loginBgStyle = (typeof loginBg !== 'undefined' && loginBg && loginBg.activeStyle)
    ? loginBg.activeStyle
    : 'background-color: #4a0e17; background-image: linear-gradient(135deg, #4a0e17 0%, #28050b 100%);';
%>
<body style="<%= loginBgStyle %>">
  <div class="portal-container">
    <div class="portal-card">
      
      <!-- Site Logo Header -->
      <a class="site-logo-wrapper" href="/" aria-label="Groxen Home">
        <div class="site-logo-mark">
          <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <circle cx="12" cy="11" r="3"/>
          </svg>
        </div>
        <span class="site-brand-name">Groxen System</span>
        <div class="superadmin-badge">
          ⚡ Dedicated Superadmin Access
        </div>
      </a>

      <div class="portal-header">
        <h1>Superadmin Authentication</h1>
        <p>Restricted access portal for root system administrators only</p>
      </div>

      <% if (locals.error) { %>
        <div class="error-alert">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <form method="POST" action="/superadmin/login" autocomplete="off">
        <div class="form-group">
          <label for="email">Superadmin Email</label>
          <div class="input-wrapper">
            <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <input id="email" type="email" name="email" class="form-control" placeholder="Enter superadmin email" value="" autocomplete="off" required autofocus />
          </div>
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <div class="input-wrapper">
            <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <input id="password" type="password" name="password" class="form-control" placeholder="Enter password" value="" autocomplete="new-password" required />
          </div>
        </div>

        <button type="submit" class="submit-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
          <span>Sign In as Superadmin</span>
        </button>
      </form>

      <div class="portal-footer">
        <a href="/">← Back to Landing Page</a>
      </div>
    </div>
  </div>

  <script>
    window.addEventListener('DOMContentLoaded', () => {
      const emailEl = document.getElementById('email');
      const passEl = document.getElementById('password');
      if (emailEl) emailEl.value = '';
      if (passEl) passEl.value = '';
    });
  </script>
</body>
</html>
