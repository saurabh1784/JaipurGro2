<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Price Revision Requests</title><style>body{font-family:Arial;background:#f6f5fb;margin:0;padding:24px;color:#1f2937}.wrap{max-width:1200px;margin:auto}.card{background:#fff;border:1px solid #ddd6fe;border-radius:14px;padding:16px;margin:12px 0}.meta{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px}.badge{font-weight:700;text-transform:capitalize}.actions{display:flex;gap:8px;margin-top:12px}button{padding:9px 14px;border:0;border-radius:8px;cursor:pointer}.approve{background:#16a34a;color:#fff}.reject{background:#dc2626;color:#fff}.changes{background:#d97706;color:#fff}img{max-width:120px;max-height:90px;border-radius:8px}</style></head><body><main class="wrap"><h1>Price Revision Requests</h1><select id="filter"><option value="">All statuses</option><option>pending</option><option>approved</option><option>rejected</option><option value="changes_required">changes required</option></select><div id="list">Loading…</div></main><script>
const list=document.getElementById('list'),filter=document.getElementById('filter'); const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function load(){const q=filter.value?'?status='+encodeURIComponent(filter.value):'';const r=await fetch('/api/vendor-products/price-revision-requests'+q,{headers:{Accept:'application/json'}});const d=await r.json();if(!d.success){list.textContent=d.message||'Unable to load';return}list.innerHTML=(d.requests||[]).map(x=>`<section class="card"><div class="meta"><div><b>Vendor</b><br>${esc(x.vendor_name)}<br>${esc(x.vendor_phone)}<br>${esc(x.vendor_city)}</div><div><b>Product</b><br>#${esc(x.product_id)} ${esc(x.product_name)}</div><div><b>Price</b><br>₹${esc(x.current_price)} → ₹${esc(x.proposed_price)}</div><div><b>Submitted</b><br>${esc(new Date(x.created_at).toLocaleString())}<br><span class="badge">${esc(x.status)}</span></div></div><p><b>Reason:</b> ${esc(x.reason)}</p>${x.proof_url?`<a href="${esc(x.proof_url)}" target="_blank">View supporting proof</a>`:''}${x.reviewer_reason?`<p><b>Reviewer reason:</b> ${esc(x.reviewer_reason)}</p>`:''}${['pending','changes_required'].includes(x.status)?`<div class="actions"><button class="approve" onclick="review(${x.id},'approved')">Approve</button><button class="changes" onclick="review(${x.id},'changes_required')">Changes Required</button><button class="reject" onclick="review(${x.id},'rejected')">Reject</button></div>`:''}</section>`).join('')||'<p>No requests found.</p>'}
async function review(id,status){let reason='';if(status!=='approved'){reason=prompt('Reviewer reason is required:')||'';if(!reason.trim())return}const r=await fetch('/api/vendor-products/price-revision-requests/'+id+'/review',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({status,reviewer_reason:reason})});const d=await r.json();if(!d.success)alert(d.message||'Review failed');else load()} filter.addEventListener('change',load);load();
</script></body></html>
