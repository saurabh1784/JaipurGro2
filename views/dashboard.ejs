          <a href="/wallets" class="vendor-metric-card">
            <div class="vendor-metric-icon icon-wallet">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="5" width="20" height="14" rx="2"/>
                <line x1="2" y1="10" x2="22" y2="10"/>
              </svg>
            </div>
            <div class="vendor-metric-content">
              <span class="vendor-metric-label">Wallet Amount</span>
              <strong class="vendor-metric-value"><%= money(dashboard.vendorCards.walletBalance) %></strong>
              <span class="vendor-metric-sub">Available balance</span>
            </div>
          </a>
        </section>
      <% } %>
