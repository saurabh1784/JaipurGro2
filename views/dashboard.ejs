    <script>
      let liveRange = 'today';
      let liveSelectedCity = 'all_assigned';
      let liveCountdownSeconds = 300;
      let liveTimerInterval = null;
      let previousScrollY = 0;
      let systemLocationData = null;

      async function initLocationOptions() {
        try {
          const response = await fetch('/api/dashboard/cities-areas', {
            headers: { Accept: 'application/json' },
          });
          const data = await response.json();
          if (!data.success) return;
          systemLocationData = data;

          // 1. Populate Live Status City Pills
          const pillsContainer = document.getElementById('liveCityPillsContainer');
          if (pillsContainer) {
            const cities = data.displayCities || [];
            let html = '<span style="font-size: 0.82rem; font-weight: 700; color: #94a3b8;">City Filter:</span>';
            if (cities.length > 1 || data.isSuper) {
              html += `<button class="live-pill ${liveSelectedCity === 'all_assigned' || liveSelectedCity === 'all' ? 'active' : ''}" type="button" onclick="setLiveCity('${data.isSuper ? 'all' : 'all_assigned'}')">${data.isSuper ? 'All Cities' : 'All Assigned Cities'}</button>`;
            }
            cities.forEach((c) => {
              const isActive = liveSelectedCity.toLowerCase() === c.toLowerCase();
              html += `<button class="live-pill ${isActive ? 'active' : ''}" type="button" onclick="setLiveCity('${c}')">${c}</button>`;
            });
            pillsContainer.innerHTML = html;
          }

          // 2. Populate Product Statistics City Select
          const citySelect = document.getElementById('prodStatsCitySelect');
          if (citySelect) {
            const cities = data.displayCities || [];
            let optionsHtml = '';
            if (cities.length > 1 || data.isSuper) {
              optionsHtml += `<option value="${data.isSuper ? 'all' : 'all_assigned'}">${data.isSuper ? 'All Cities' : 'All Assigned Cities'}</option>`;
            }
            cities.forEach((c) => {
              optionsHtml += `<option value="${c}">${c}</option>`;
            });
            citySelect.innerHTML = optionsHtml;
            if (cities.length === 1 && !data.isSuper) {
              citySelect.value = cities[0];
            }
          }

          onProdStatsCityChange();
        } catch (err) {
          console.error('Error initializing location options:', err);
        }
      }

      function setLiveCity(city) {
        liveSelectedCity = city;
        const pillsContainer = document.getElementById('liveCityPillsContainer');
        if (pillsContainer) {
          pillsContainer.querySelectorAll('.live-pill').forEach((btn) => {
            const txt = btn.textContent.trim().toLowerCase();
            const target = city.toLowerCase();
            const isAll = (target === 'all_assigned' || target === 'all') && (txt === 'all cities' || txt === 'all assigned cities');
            btn.classList.toggle('active', isAll || txt === target);
          });
        }
        fetchLiveStatus();
      }

      function openLiveStatusModal() {
        previousScrollY = window.scrollY;
        const modal = document.getElementById('liveStatusModal');
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
        fetchLiveStatus();
        startLiveCountdown();
      }

      function closeLiveStatusModal() {
        const modal = document.getElementById('liveStatusModal');
        modal.classList.remove('active');
        document.body.style.overflow = '';
        window.scrollTo(0, previousScrollY);
        if (liveTimerInterval) clearInterval(liveTimerInterval);
      }

      function setLiveDateRange(range) {
        liveRange = range;
        document.querySelectorAll('.live-filter-pills .live-pill').forEach((btn) => {
          btn.classList.toggle('active', btn.getAttribute('data-range') === range);
        });
        const customGroup = document.getElementById('liveCustomDatesGroup');
        if (customGroup) customGroup.style.display = range === 'custom' ? 'flex' : 'none';

        if (range !== 'custom') {
          fetchLiveStatus();
        }
      }

      function startLiveCountdown() {
        if (liveTimerInterval) clearInterval(liveTimerInterval);
        liveCountdownSeconds = 300;
        updateCountdownText();

        liveTimerInterval = setInterval(() => {
          liveCountdownSeconds--;
          if (liveCountdownSeconds <= 0) {
            fetchLiveStatus();
            liveCountdownSeconds = 300;
          }
          updateCountdownText();
        }, 1000);
      }

      function updateCountdownText() {
        const m = Math.floor(liveCountdownSeconds / 60);
        const s = liveCountdownSeconds % 60;
        const text = `Next refresh in ${m}m ${s < 10 ? '0' : ''}${s}s`;
        const el = document.getElementById('liveCountdownText');
        if (el) el.textContent = text;
      }

      function refreshLiveStatusNow() {
        fetchLiveStatus();
        liveCountdownSeconds = 300;
        updateCountdownText();
      }

      async function fetchLiveStatus() {
        try {
          const fromDate = document.getElementById('liveFromDate')?.value || '';
          const toDate = document.getElementById('liveToDate')?.value || '';
          const params = new URLSearchParams({
            range: liveRange,
            city: liveSelectedCity,
          });
          if (liveRange === 'custom') {
            params.append('fromDate', fromDate);
            params.append('toDate', toDate);
          }

          const response = await fetch(`/api/dashboard/live-status?${params.toString()}`, {
            headers: { Accept: 'application/json' },
          });
          const data = await response.json();
          if (!data.success) return;

          // Main Dashboard Summary Cards
          if (document.getElementById('mainTotalClients')) document.getElementById('mainTotalClients').textContent = data.summary.totalClients;
          if (document.getElementById('mainTotalVendors')) document.getElementById('mainTotalVendors').textContent = data.summary.totalVendors;
          if (document.getElementById('mainTotalDp')) document.getElementById('mainTotalDp').textContent = data.summary.totalDeliveryPartners;
          if (document.getElementById('mainOnlineClients')) document.getElementById('mainOnlineClients').textContent = data.summary.onlineClients;
          if (document.getElementById('mainOnlineVendors')) document.getElementById('mainOnlineVendors').textContent = data.summary.onlineVendors;
          if (document.getElementById('mainOnlineDp')) document.getElementById('mainOnlineDp').textContent = data.summary.onlineDeliveryPartners;

          // Live Modal Meta
          if (document.getElementById('liveLastUpdated')) document.getElementById('liveLastUpdated').textContent = data.lastUpdated;

          // Quotation Metrics
          if (document.getElementById('qTotalLive')) document.getElementById('qTotalLive').textContent = data.quotations.totalLive;
          if (document.getElementById('qReceivingBids')) document.getElementById('qReceivingBids').textContent = data.quotations.receivingBids;
          if (document.getElementById('qWaitingBids')) document.getElementById('qWaitingBids').textContent = data.quotations.waitingVendorBids;
          if (document.getElementById('qNearExpiry')) document.getElementById('qNearExpiry').textContent = data.quotations.nearExpiry;
          if (document.getElementById('qCompleted')) document.getElementById('qCompleted').textContent = data.quotations.completed;
          if (document.getElementById('qClosedNoBid')) document.getElementById('qClosedNoBid').textContent = data.quotations.closedWithoutBid;
          if (document.getElementById('qTotalBids')) document.getElementById('qTotalBids').textContent = data.quotations.totalBidsReceived;
          if (document.getElementById('qParticipatingVendors')) document.getElementById('qParticipatingVendors').textContent = data.quotations.participatingVendors;

          // Order Metrics
          if (document.getElementById('ordTotal')) document.getElementById('ordTotal').textContent = data.orders.total;
          if (document.getElementById('ordPending')) document.getElementById('ordPending').textContent = data.orders.pending;
          if (document.getElementById('ordAccepted')) document.getElementById('ordAccepted').textContent = data.orders.accepted;
          if (document.getElementById('ordProcessing')) document.getElementById('ordProcessing').textContent = data.orders.processing;
          if (document.getElementById('ordReady')) document.getElementById('ordReady').textContent = data.orders.readyForPickup;
          if (document.getElementById('ordAssigned')) document.getElementById('ordAssigned').textContent = data.orders.assignedToDp;
          if (document.getElementById('ordPickedUp')) document.getElementById('ordPickedUp').textContent = data.orders.pickedUp;
          if (document.getElementById('ordOnTheWay')) document.getElementById('ordOnTheWay').textContent = data.orders.onTheWay;
          if (document.getElementById('ordDelivered')) document.getElementById('ordDelivered').textContent = data.orders.delivered;
          if (document.getElementById('ordCancelled')) document.getElementById('ordCancelled').textContent = data.orders.cancelled;
          if (document.getElementById('ordFailed')) document.getElementById('ordFailed').textContent = data.orders.failed;
          if (document.getElementById('ordReturned')) document.getElementById('ordReturned').textContent = data.orders.returned;

          // Operational Alerts
          if (document.getElementById('alertVendorAccept')) document.getElementById('alertVendorAccept').textContent = data.orders.waitingVendorAcceptance;
          if (document.getElementById('alertDeliveryAssign')) document.getElementById('alertDeliveryAssign').textContent = data.orders.waitingDeliveryAssignment;
          if (document.getElementById('alertDelayed')) document.getElementById('alertDelayed').textContent = data.orders.delayedOrders;
          if (document.getElementById('alertComplaints')) document.getElementById('alertComplaints').textContent = data.orders.activeComplaints;

          // Online Activity
          if (document.getElementById('actClients')) document.getElementById('actClients').textContent = data.activity.onlineClients;
          if (document.getElementById('actVendors')) document.getElementById('actVendors').textContent = data.activity.onlineVendors;
          if (document.getElementById('actDp')) document.getElementById('actDp').textContent = data.activity.onlineDeliveryPartners;
          if (document.getElementById('actVendorsBidding')) document.getElementById('actVendorsBidding').textContent = data.activity.vendorsBidding;
          if (document.getElementById('actDpFree')) document.getElementById('actDpFree').textContent = data.activity.dpFree;
          if (document.getElementById('actDpOnOrder')) document.getElementById('actDpOnOrder').textContent = data.activity.dpOnOrder;
          if (document.getElementById('actDpOnTheWay')) document.getElementById('actDpOnTheWay').textContent = data.activity.dpOnTheWay;
          if (document.getElementById('actClientsTracking')) document.getElementById('actClientsTracking').textContent = data.activity.clientsTracking;
        } catch (err) {
          console.error('Error loading live status:', err);
        }
      }

      async function openLiveDetail(type) {
        const overlay = document.getElementById('liveDetailSubModal');
        const body = document.getElementById('liveDetailBody');
        const title = document.getElementById('liveDetailTitle');

        title.textContent = `List Details (${type})`;
        body.innerHTML = '<p style="color: #94a3b8;">Loading details...</p>';
        overlay.classList.add('active');

        try {
          const response = await fetch(`/api/dashboard/live-details?type=${encodeURIComponent(type)}&city=${encodeURIComponent(liveSelectedCity)}`, {
            headers: { Accept: 'application/json' },
          });
          const data = await response.json();
          if (!data.success || !data.items || !data.items.length) {
            body.innerHTML = '<p style="color: #94a3b8;">No records found for this category.</p>';
            return;
          }

          body.innerHTML = `
            <table class="users-table" style="color:#f8fafc;">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Details</th>
                  <th>Info</th>
                  <th>Status</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                ${data.items.map(item => `
                  <tr>
                    <td><strong style="color:#38bdf8;">${item.id}</strong></td>
                    <td>${item.title}</td>
                    <td>${item.sub}</td>
                    <td><span class="user-status-pill active">${item.status}</span></td>
                    <td>${new Date(item.date).toLocaleDateString()}</td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          `;
        } catch (err) {
          body.innerHTML = '<p style="color: #ef4444;">Failed to load detail items.</p>';
        }
      }

      function closeLiveDetailSubModal() {
        document.getElementById('liveDetailSubModal').classList.remove('active');
      }

      // --- Product Statistics & Area Filters ---
      function onProdStatsCityChange() {
        const citySelect = document.getElementById('prodStatsCitySelect');
        const areaSelect = document.getElementById('prodStatsAreaSelect');
        if (!citySelect || !areaSelect) return;

        const selectedCity = citySelect.value;
        const cityAreasMap = (systemLocationData && systemLocationData.cityAreasMap) || {};

        let areas = [];
        if (selectedCity && selectedCity !== 'all_assigned' && selectedCity !== 'all') {
          // Find matching city key
          const matchKey = Object.keys(cityAreasMap).find((k) => k.toLowerCase() === selectedCity.toLowerCase());
          if (matchKey) {
            areas = cityAreasMap[matchKey];
          }
        }

        let areaHtml = '<option value="all">All Areas</option>';
        areas.forEach((a) => {
          areaHtml += `<option value="${a}">${a}</option>`;
        });
        areaSelect.innerHTML = areaHtml;
        fetchProductStats();
      }

      async function fetchProductStats() {
        const citySelect = document.getElementById('prodStatsCitySelect');
        const areaSelect = document.getElementById('prodStatsAreaSelect');
        if (!citySelect) return;

        const city = citySelect.value || 'all_assigned';
        const area = areaSelect ? areaSelect.value : 'all';

        try {
          const params = new URLSearchParams({ city, area });
          const response = await fetch(`/api/dashboard/product-stats?${params.toString()}`, {
            headers: { Accept: 'application/json' },
          });
          const data = await response.json();
          if (!data.success) return;

          // Metrics Overview
          if (document.getElementById('psActive')) document.getElementById('psActive').textContent = data.metrics.totalActiveProducts;
          if (document.getElementById('psInactive')) document.getElementById('psInactive').textContent = data.metrics.totalInactiveProducts;
          if (document.getElementById('psApproved')) document.getElementById('psApproved').textContent = data.metrics.totalApprovedProducts;
          if (document.getElementById('psPending')) document.getElementById('psPending').textContent = data.metrics.totalPendingProducts;
          if (document.getElementById('psOutOfStock')) document.getElementById('psOutOfStock').textContent = data.metrics.totalOutOfStockProducts;
          if (document.getElementById('psLowStock')) document.getElementById('psLowStock').textContent = data.metrics.totalLowInventoryProducts;

          // Render Most Sold Products Table
          const mostSoldTbody = document.getElementById('psMostSoldTable');
          if (mostSoldTbody) {
            if (!data.mostSoldProducts || !data.mostSoldProducts.length) {
              mostSoldTbody.innerHTML = '<tr><td colspan="6" style="padding: 16px; text-align: center; color: #94a3b8;">No sales records found</td></tr>';
            } else {
              mostSoldTbody.innerHTML = data.mostSoldProducts.map((p) => `
                <tr style="border-bottom: 1px solid #334155;">
                  <td style="padding: 10px 12px; display: flex; align-items: center; gap: 8px;">
                    <img src="${p.imageUrl}" alt="" style="width: 28px; height: 28px; border-radius: 4px; object-fit: cover;" onerror="this.src='/placeholder.png'" />
                    <span style="font-weight: 700; color: #f8fafc;">${p.name}</span>
                  </td>
                  <td style="padding: 10px 12px; color: #94a3b8;">#${p.productId}</td>
                  <td style="padding: 10px 12px; color: #cbd5e1;">${p.category}</td>
                  <td style="padding: 10px 12px; text-align: right; font-weight: 700; color: #34d399;">${p.totalQuantitySold}</td>
                  <td style="padding: 10px 12px; text-align: right; color: #cbd5e1;">${p.totalOrders}</td>
                  <td style="padding: 10px 12px; text-align: right; font-weight: 700; color: #38bdf8;">INR ${p.salesAmount.toFixed(2)}</td>
                </tr>
              `).join('');
            }
          }

          // Render Most Returned Products Table
          const mostReturnedTbody = document.getElementById('psMostReturnedTable');
          if (mostReturnedTbody) {
            if (!data.mostReturnedProducts || !data.mostReturnedProducts.length) {
              mostReturnedTbody.innerHTML = '<tr><td colspan="5" style="padding: 16px; text-align: center; color: #94a3b8;">No return records found</td></tr>';
            } else {
              mostReturnedTbody.innerHTML = data.mostReturnedProducts.map((p) => `
                <tr style="border-bottom: 1px solid #334155;">
                  <td style="padding: 10px 12px; display: flex; align-items: center; gap: 8px;">
                    <img src="${p.imageUrl}" alt="" style="width: 28px; height: 28px; border-radius: 4px; object-fit: cover;" onerror="this.src='/placeholder.png'" />
                    <span style="font-weight: 700; color: #f8fafc;">${p.name}</span>
                  </td>
                  <td style="padding: 10px 12px; color: #94a3b8;">#${p.productId}</td>
                  <td style="padding: 10px 12px; color: #cbd5e1;">${p.category}</td>
                  <td style="padding: 10px 12px; text-align: right; font-weight: 700; color: #f87171;">${p.totalQuantityReturned}</td>
                  <td style="padding: 10px 12px; text-align: right; color: #cbd5e1;">${p.totalOrders}</td>
                </tr>
              `).join('');
            }
          }

          // Highest Revenue Table
          const highestRevTbody = document.getElementById('psHighestRevenueTable');
          if (highestRevTbody) {
            if (!data.highestRevenueProducts || !data.highestRevenueProducts.length) {
              highestRevTbody.innerHTML = '<tr><td colspan="4" style="padding: 16px; text-align: center; color: #94a3b8;">No revenue records</td></tr>';
            } else {
              highestRevTbody.innerHTML = data.highestRevenueProducts.map((p) => `
                <tr style="border-bottom: 1px solid #334155;">
                  <td style="padding: 10px 12px; font-weight: 700; color: #f8fafc;">${p.name}</td>
                  <td style="padding: 10px 12px; color: #cbd5e1;">${p.category}</td>
                  <td style="padding: 10px 12px; text-align: right; color: #cbd5e1;">${p.totalQuantitySold}</td>
                  <td style="padding: 10px 12px; text-align: right; font-weight: 700; color: #34d399;">INR ${p.totalRevenue.toFixed(2)}</td>
                </tr>
              `).join('');
            }
          }

          // Lowest Sales Table
          const lowestSalesTbody = document.getElementById('psLowestSalesTable');
          if (lowestSalesTbody) {
            if (!data.lowestSalesProducts || !data.lowestSalesProducts.length) {
              lowestSalesTbody.innerHTML = '<tr><td colspan="3" style="padding: 16px; text-align: center; color: #94a3b8;">No records</td></tr>';
            } else {
              lowestSalesTbody.innerHTML = data.lowestSalesProducts.map((p) => `
                <tr style="border-bottom: 1px solid #334155;">
                  <td style="padding: 10px 12px; font-weight: 700; color: #f8fafc;">${p.name}</td>
                  <td style="padding: 10px 12px; color: #cbd5e1;">${p.category}</td>
                  <td style="padding: 10px 12px; text-align: right; font-weight: 700; color: #fbbf24;">${p.totalQuantitySold}</td>
                </tr>
              `).join('');
            }
          }

          // Top Categories List
          const topCatList = document.getElementById('psTopCategoriesList');
          if (topCatList) {
            if (!data.topCategories || !data.topCategories.length) {
              topCatList.innerHTML = '<li style="color: #94a3b8;">No category data</li>';
            } else {
              topCatList.innerHTML = data.topCategories.map((c) => `
                <li style="padding: 8px 0; border-bottom: 1px solid #334155; display: flex; justify-content: space-between;">
                  <span style="font-weight: 700; color: #f8fafc;">${c.name}</span>
                  <span style="color: #34d399; font-weight: 700;">INR ${c.totalSales.toFixed(2)} (${c.totalQuantity} units)</span>
                </li>
              `).join('');
            }
          }

          // Top Subcategories List
          const topSubcatList = document.getElementById('psTopSubcategoriesList');
          if (topSubcatList) {
            if (!data.topSubcategories || !data.topSubcategories.length) {
              topSubcatList.innerHTML = '<li style="color: #94a3b8;">No subcategory data</li>';
            } else {
              topSubcatList.innerHTML = data.topSubcategories.map((sc) => `
                <li style="padding: 8px 0; border-bottom: 1px solid #334155; display: flex; justify-content: space-between;">
                  <span style="font-weight: 700; color: #f8fafc;">${sc.name} <small style="color:#94a3b8;">(${sc.category})</small></span>
                  <span style="color: #34d399; font-weight: 700;">INR ${sc.totalSales.toFixed(2)}</span>
                </li>
              `).join('');
            }
          }

          // Area Performance Content
          const areaContent = document.getElementById('psAreaBreakdownContent');
          if (areaContent) {
            const am = data.areaMetrics || {};
            areaContent.innerHTML = `
              <div style="background: #1e293b; border: 1px solid #334155; padding: 12px; border-radius: 8px; margin-bottom: 10px;">
                <span style="color: #94a3b8; font-size: 0.78rem;">Best-Selling Area:</span>
                <strong style="display: block; font-size: 1.05rem; color: #34d399;">${am.bestSellingArea || 'N/A'}</strong>
              </div>
              <ul style="list-style: none; padding: 0; margin: 0; line-height: 1.8; color: #cbd5e1;">
                <li><strong style="color:#f8fafc;">Total Sales by Area:</strong> INR ${(am.totalSalesByArea || 0).toFixed(2)}</li>
                <li><strong style="color:#f8fafc;">Total Orders by Area:</strong> ${am.totalOrdersByArea || 0}</li>
                <li><strong style="color:#f8fafc;">Returned Products in Area:</strong> ${am.totalReturnedProductsByArea || 0}</li>
                <li><strong style="color:#f8fafc;">Active Vendors in Area:</strong> ${am.activeVendorsByArea || 0}</li>
                <li><strong style="color:#f8fafc;">Active Clients in Area:</strong> ${am.activeClientsByArea || 0}</li>
              </ul>
            `;
          }
        } catch (err) {
          console.error('Error fetching product statistics:', err);
        }
      }

      // Initial load
      window.addEventListener('DOMContentLoaded', () => {
        initLocationOptions();
        fetchLiveStatus();
      });
    </script>
  <% } %>
</body>
</html>
