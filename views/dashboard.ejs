            </div>
          </a>

          <a href="/orders/vendor" class="vendor-metric-card">
            <div class="vendor-metric-icon icon-orders">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M16 11V7a4 4 0 0 0-8 0v4M5 9h14l1 12H4L5 9z"/>
              </svg>
            </div>
            <div class="vendor-metric-content">
              <span class="vendor-metric-label">Received Orders</span>
              <strong class="vendor-metric-value"><%= dashboard.vendorCards.totalOrders %></strong>
              <span class="vendor-metric-sub">Total client orders</span>
            </div>
