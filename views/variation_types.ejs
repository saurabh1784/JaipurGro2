<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css" />
  <style>
    .variation-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 1.5rem;
    }
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
    }
    .page-header h1 {
      font-size: 1.75rem;
      font-weight: 800;
      color: #0f172a;
      margin: 0;
    }
    .header-actions {
      display: flex;
      gap: 0.75rem;
    }
    .btn-primary {
      background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
      color: #ffffff;
      border: none;
      padding: 0.65rem 1.25rem;
      border-radius: 12px;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      transition: all 0.2s ease;
    }
    .btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 16px -4px rgba(79, 70, 229, 0.4);
    }
    .btn-secondary {
      background: #f1f5f9;
      color: #334155;
      border: 1px solid #cbd5e1;
      padding: 0.65rem 1.25rem;
      border-radius: 12px;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .btn-secondary:hover {
      background: #e2e8f0;
    }
    .type-card {
      background: #ffffff;
      border-radius: 16px;
      border: 1px solid #e2e8f0;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
      margin-bottom: 1.5rem;
      overflow: hidden;
    }
    .type-header {
      background: #f8fafc;
      padding: 1rem 1.25rem;
      border-bottom: 1px solid #e2e8f0;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .type-header-title {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .type-header-title h3 {
      margin: 0;
      font-size: 1.1rem;
      font-weight: 700;
      color: #0f172a;
    }
    .type-code-badge {
      background: #e0e7ff;
      color: #3730a3;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 6px;
      text-transform: lowercase;
    }
    .values-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      padding: 1.25rem;
    }
    .value-chip {
      background: #f8fafc;
      border: 1px solid #cbd5e1;
      border-radius: 12px;
      padding: 6px 14px;
      font-size: 0.875rem;
      font-weight: 600;
      color: #334155;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .value-chip .unit {
      color: #64748b;
      font-size: 0.8rem;
    }
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      z-index: 9999;
      opacity: 0;
      pointer-events: none;
      transition: all 0.2s ease;
    }
    .modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }
    .modal-content {
      background: #ffffff;
      border-radius: 20px;
      width: 100%;
      max-width: 480px;
      padding: 1.75rem;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    }
    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.25rem;
    }
    .modal-header h2 {
      margin: 0;
      font-size: 1.25rem;
      font-weight: 800;
    }
    .close-btn {
      background: none;
      border: none;
      font-size: 1.5rem;
      cursor: pointer;
      color: #94a3b8;
    }
  </style>
</head>
<body>
  <div class="variation-container">
    <div class="page-header">
      <div>
        <h1>Product Variation Types</h1>
        <p style="color:#64748b;margin:0.25rem 0 0;">Manage master variation groups and values (Weight, Volume, Pack Quantity, etc.)</p>
      </div>
      <div class="header-actions">
        <button class="btn-secondary" onclick="openValueModal()">+ Add Variation Value</button>
        <button class="btn-primary" onclick="openTypeModal()">+ New Variation Type</button>
      </div>
    </div>

    <% if (locals.message) { %>
      <div style="background:#ecfdf5;border:1px solid #a7f3d0;color:#047857;padding:0.75rem 1rem;border-radius:12px;margin-bottom:1.5rem;font-weight:600;">
        ✓ <%= message %>
      </div>
    <% } %>
    <% if (locals.error) { %>
      <div style="background:#fef2f2;border:1px solid #fecaca;color:#dc2626;padding:0.75rem 1rem;border-radius:12px;margin-bottom:1.5rem;font-weight:600;">
        ⚠ <%= error %>
      </div>
    <% } %>

    <!-- Variation Types List -->
    <% if (types && types.length) { %>
      <% types.forEach(type => { %>
        <div class="type-card">
          <div class="type-header">
            <div class="type-header-title">
              <h3><%= type.name %></h3>
              <span class="type-code-badge"><%= type.code %></span>
            </div>
            <button class="btn-secondary" style="padding:4px 10px;font-size:0.8rem;" onclick="openValueModal('<%= type.id %>')">+ Add Value</button>
          </div>
          <div class="values-grid">
            <% if (type.values && type.values.length) { %>
              <% type.values.forEach(val => { %>
                <div class="value-chip">
                  <span><%= val.value %></span>
                  <% if (val.unit) { %><span class="unit"><%= val.unit %></span><% } %>
                </div>
              <% }) %>
            <% } else { %>
              <div style="color:#94a3b8;font-size:0.875rem;font-style:italic;">No values added yet for this variation type.</div>
            <% } %>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div style="text-align:center;padding:3rem;background:#ffffff;border-radius:16px;border:1px dashed #cbd5e1;">
        <h3>No Variation Types Found</h3>
        <p style="color:#64748b;">Click "+ New Variation Type" above to create your first variation group.</p>
      </div>
    <% } %>
  </div>

  <!-- Add Type Modal -->
  <div class="modal-overlay" id="typeModal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Add Variation Type</h2>
        <button class="close-btn" onclick="closeModal('typeModal')">&times;</button>
      </div>
      <form action="/admin/variation-types" method="POST">
        <div style="margin-bottom:1rem;">
          <label style="display:block;font-weight:700;margin-bottom:0.4rem;font-size:0.85rem;">Type Name (e.g. Weight, Pack Size)</label>
          <input type="text" name="name" class="form-control" style="width:100%;padding:0.75rem;border-radius:10px;border:1px solid #cbd5e1;" required placeholder="e.g. Weight" />
        </div>
        <div style="margin-bottom:1.25rem;">
          <label style="display:block;font-weight:700;margin-bottom:0.4rem;font-size:0.85rem;">Code (Slug)</label>
          <input type="text" name="code" class="form-control" style="width:100%;padding:0.75rem;border-radius:10px;border:1px solid #cbd5e1;" placeholder="e.g. weight (optional)" />
        </div>
        <button type="submit" class="btn-primary" style="width:100%;justify-center;">Save Variation Type</button>
      </form>
    </div>
  </div>

  <!-- Add Value Modal -->
  <div class="modal-overlay" id="valueModal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Add Variation Value</h2>
        <button class="close-btn" onclick="closeModal('valueModal')">&times;</button>
      </div>
      <form action="/admin/variation-values" method="POST">
        <div style="margin-bottom:1rem;">
          <label style="display:block;font-weight:700;margin-bottom:0.4rem;font-size:0.85rem;">Variation Type</label>
          <select name="variation_type_id" id="valTypeSelect" class="form-control" style="width:100%;padding:0.75rem;border-radius:10px;border:1px solid #cbd5e1;" required>
            <% types.forEach(t => { %>
              <option value="<%= t.id %>"><%= t.name %></option>
            <% }) %>
          </select>
        </div>
        <div style="margin-bottom:1rem;">
          <label style="display:block;font-weight:700;margin-bottom:0.4rem;font-size:0.85rem;">Value (e.g. 1, 500, Pouch)</label>
          <input type="text" name="value" class="form-control" style="width:100%;padding:0.75rem;border-radius:10px;border:1px solid #cbd5e1;" required placeholder="e.g. 1" />
        </div>
        <div style="margin-bottom:1.25rem;">
          <label style="display:block;font-weight:700;margin-bottom:0.4rem;font-size:0.85rem;">Unit (e.g. kg, g, ml, L, pieces)</label>
          <input type="text" name="unit" class="form-control" style="width:100%;padding:0.75rem;border-radius:10px;border:1px solid #cbd5e1;" placeholder="e.g. kg" />
        </div>
        <button type="submit" class="btn-primary" style="width:100%;justify-center;">Save Variation Value</button>
      </form>
    </div>
  </div>

  <script>
    function openTypeModal() {
      document.getElementById('typeModal').classList.add('active');
    }
    function openValueModal(typeId) {
      if (typeId) {
        document.getElementById('valTypeSelect').value = typeId;
      }
      document.getElementById('valueModal').classList.add('active');
    }
    function closeModal(id) {
      document.getElementById(id).classList.remove('active');
    }
  </script>
</body>
</html>
